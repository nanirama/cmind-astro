---
interface BreadcrumbItem {
  label: string;
  href: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb">
  <ol class="breadcrumb" role="list">
    <li class="breadcrumb__item">
      <a href="/" class="breadcrumb__link">Home</a>
    </li>
    {items.map((item, index) => (
      <li class="breadcrumb__item">
        <svg class="breadcrumb__sep" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M4.5 2.5L7.5 6l-3 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        {index === items.length - 1 ? (
          <span class="breadcrumb__current" aria-current="page">{item.label}</span>
        ) : (
          <a href={item.href} class="breadcrumb__link">{item.label}</a>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3xs);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .breadcrumb__item {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
  }

  .breadcrumb__link {
    font-size: var(--fs-text-sm);
    color: var(--color-text-tertiary);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out-quart);
  }

  .breadcrumb__link:hover {
    color: var(--color-primary-600);
  }

  .breadcrumb__sep {
    color: var(--color-border-strong);
    flex-shrink: 0;
  }

  .breadcrumb__current {
    font-size: var(--fs-text-sm);
    color: var(--color-text-secondary);
    font-weight: 500;
  }
</style>
