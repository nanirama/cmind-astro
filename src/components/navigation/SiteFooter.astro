---
import { footerNav, socialLinks } from '@data/navigation';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <!-- Top section -->
    <div class="site-footer__top">
      <!-- Brand column -->
      <div class="site-footer__brand">
        <a href="/" class="site-footer__logo" aria-label="CapitalMind – Home">
          <svg width="160" height="36" viewBox="0 0 160 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect width="8" height="36" rx="2" fill="currentColor" class="text-gold-400" />
            <rect x="4" y="8" width="8" height="28" rx="2" fill="currentColor" opacity="0.4" />
            <text x="20" y="26" font-family="Noto Serif, serif" font-size="20" font-weight="700" fill="currentColor">CapitalMind</text>
          </svg>
        </a>
        <p class="site-footer__tagline">
          Research-driven investing for the discerning Indian investor, NRI, and founder.
        </p>
        <!-- Social links -->
        <ul class="site-footer__social" aria-label="Social media links" role="list">
          {socialLinks.map((link) => (
            <li>
            <a
              href={link.href}
              class="site-footer__social-link"
              aria-label={`${link.label} (opens in new tab)`}
              target="_blank"
              rel="noopener noreferrer"
            >
              {link.icon === 'twitter' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.748l7.73-8.835L1.254 2.25H8.08l4.258 5.636zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              )}
              {link.icon === 'linkedin' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              )}
              {link.icon === 'youtube' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                </svg>
              )}
            </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Nav columns -->
      {Object.values(footerNav).map((col) => (
        <nav class="site-footer__nav" aria-label={`${col.label} navigation`}>
          <h3 class="site-footer__nav-heading">{col.label}</h3>
          <ul class="site-footer__nav-list" role="list">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="site-footer__nav-link">{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <!-- Divider -->
    <hr class="site-footer__divider" />

    <!-- Regulatory disclaimer -->
    <div class="site-footer__disclaimer" role="note" aria-label="Regulatory disclaimer">
      <p>
        CapitalMind is a SEBI registered Investment Adviser (Registration No. INA000001398).
        Investments in securities markets are subject to market risks. Please read all related
        documents carefully before investing. Past performance is not indicative of future results.
        The information provided is for educational purposes only and should not be construed
        as investment advice.
      </p>
    </div>

    <!-- Bottom bar -->
    <div class="site-footer__bottom">
      <p class="site-footer__copyright">
        &copy; {currentYear} CapitalMind Financial Services Pvt. Ltd. All rights reserved.
      </p>
      <div class="site-footer__legal-links">
        <a href="/legal/privacy">Privacy</a>
        <a href="/legal/terms">Terms</a>
        <a href="/legal/disclaimer">Disclaimer</a>
        <a href="/legal/sebi">SEBI Disclosures</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-primary-900);
    color: var(--color-beige-200);
    padding-top: var(--space-4xl);
    padding-bottom: var(--space-xl);
    margin-top: auto;
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
  }

  @media (min-width: 640px) {
    .site-footer__top {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .site-footer__top {
      grid-template-columns: 2fr repeat(4, 1fr);
    }
  }

  .site-footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .site-footer__logo {
    color: var(--color-beige-100);
    text-decoration: none;
    display: inline-flex;
    transition: opacity var(--duration-fast) var(--ease-out-quart);
  }

  .site-footer__logo:hover { opacity: 0.8; }

  .site-footer__tagline {
    font-size: var(--fs-text-sm);
    color: var(--color-beige-400);
    line-height: var(--lh-text-lg);
    max-width: 28ch;
    margin: 0;
  }

  .site-footer__social {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-xs);
    list-style: none;
    padding: 0;
    margin-left: 0;
  }

  .site-footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-md);
    background-color: rgba(255 255 255 / 0.08);
    color: var(--color-beige-300);
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-out-quart),
      color var(--duration-fast) var(--ease-out-quart);
  }

  .site-footer__social-link:hover {
    background-color: rgba(255 255 255 / 0.15);
    color: var(--color-beige-100);
  }

  .site-footer__nav-heading {
    font-family: var(--font-sans);
    font-size: var(--fs-text-xs);
    font-weight: 700;
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--color-beige-500);
    margin: 0 0 var(--space-md);
  }

  .site-footer__nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .site-footer__nav-link {
    font-size: var(--fs-text-sm);
    color: var(--color-beige-300);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out-quart);
  }

  .site-footer__nav-link:hover {
    color: var(--color-beige-100);
  }

  .site-footer__divider {
    border: none;
    border-top: 1px solid rgba(255 255 255 / 0.1);
    margin: var(--space-2xl) 0 var(--space-lg);
  }

  .site-footer__disclaimer {
    max-width: 80ch;
    margin-bottom: var(--space-lg);
  }

  .site-footer__disclaimer p {
    font-size: var(--fs-text-xs);
    color: var(--color-beige-600);
    line-height: var(--lh-text-lg);
    margin: 0;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .site-footer__copyright {
    font-size: var(--fs-text-xs);
    color: var(--color-beige-600);
    margin: 0;
  }

  .site-footer__legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .site-footer__legal-links a {
    font-size: var(--fs-text-xs);
    color: var(--color-beige-500);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out-quart);
  }

  .site-footer__legal-links a:hover {
    color: var(--color-beige-200);
  }
</style>
