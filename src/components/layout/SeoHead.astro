---
import type { SeoProps } from '@lib/seo';
import { buildSeo, buildOrganizationJsonLd } from '@lib/seo';

interface Props extends SeoProps {
  slot?: string;
}

const props  = Astro.props;
const seo    = buildSeo(props);
const orgLd  = buildOrganizationJsonLd();
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
---

<!-- Primary meta -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#3DB15B" />
<title>{seo.fullTitle}</title>
<meta name="description" content={seo.description} />
{seo.canonical && <link rel="canonical" href={seo.canonical} />}
{!seo.canonical && <link rel="canonical" href={pageUrl} />}
{seo.noIndex && <meta name="robots" content="noindex,nofollow" />}
{!seo.noIndex && <meta name="robots" content="index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1" />}

<!-- Open Graph -->
<meta property="og:site_name" content={seo.SITE_NAME} />
<meta property="og:type" content={seo.ogType} />
<meta property="og:url" content={seo.canonical || pageUrl} />
<meta property="og:title" content={seo.fullTitle} />
<meta property="og:description" content={seo.description} />
<meta property="og:image" content={seo.ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_IN" />

{seo.publishDate && (
  <meta property="article:published_time" content={seo.publishDate.toISOString()} />
)}
{seo.updatedDate && (
  <meta property="article:modified_time" content={seo.updatedDate.toISOString()} />
)}
{seo.author && <meta property="article:author" content={seo.author} />}

<!-- Twitter Cards -->
<meta name="twitter:card" content={seo.twitterCard} />
<meta name="twitter:site" content="@capitalmind_in" />
<meta name="twitter:creator" content="@capitalmind_in" />
<meta name="twitter:title" content={seo.fullTitle} />
<meta name="twitter:description" content={seo.description} />
<meta name="twitter:image" content={seo.ogImage} />

<!-- Favicons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<!-- RSS -->
<link rel="alternate" type="application/rss+xml" title="CapitalMind Insights" href="/rss.xml" />

<!-- Font preloads (above-fold critical fonts only) -->
<link rel="preload" href="/fonts/NotoSerif_Condensed-Medium.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
<link rel="preload" href="/fonts/Inter-Variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />

<!-- Organization JSON-LD (on every page) -->
<script is:inline type="application/ld+json" set:html={JSON.stringify(orgLd)} />

<!-- Page-specific JSON-LD -->
{seo.jsonLd && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(seo.jsonLd)} />
)}

<!-- Additional head content from parent layouts -->
<slot />
