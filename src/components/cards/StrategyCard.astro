---
import Badge from '@components/ui/Badge.astro';

interface Props {
  name: string;
  description: string;
  href: string;
  returns?: string;
  risk?: 'low' | 'moderate' | 'high' | 'very-high';
  category?: string;
  image?: { src: string; alt: string };
}

const { name, description, href, returns, risk, category, image } = Astro.props;

const riskLabel: Record<string, string> = {
  low:       'Low Risk',
  moderate:  'Moderate Risk',
  high:      'High Risk',
  'very-high': 'Very High Risk',
};

const riskColor: Record<string, 'primary' | 'gold' | 'beige'> = {
  low:       'primary',
  moderate:  'gold',
  high:      'beige',
  'very-high': 'beige',
};
---

<article class="strategy-card card card-hover">
  {image && (
    <div class="strategy-card__image-wrapper">
      <img
        src={image.src}
        alt={image.alt}
        width="400"
        height="240"
        loading="lazy"
        decoding="async"
        class="strategy-card__image"
      />
    </div>
  )}

  <div class="strategy-card__content">
    <div class="strategy-card__meta">
      {category && <Badge variant="primary">{category}</Badge>}
      {risk && <Badge variant={riskColor[risk] ?? 'primary'}>{riskLabel[risk]}</Badge>}
    </div>

    <h2 class="strategy-card__name">
      <a href={href} class="strategy-card__link">{name}</a>
    </h2>

    <p class="strategy-card__desc body-sm">{description}</p>

    {returns && (
      <div class="strategy-card__returns" aria-label="Target returns">
        <span class="strategy-card__returns-label">Target Returns</span>
        <span class="strategy-card__returns-value">{returns}</span>
      </div>
    )}
  </div>
</article>

<style>
  .strategy-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 0;
    position: relative;
  }

  .strategy-card__image-wrapper {
    overflow: hidden;
    aspect-ratio: 5 / 3;
    background-color: var(--color-surface-raised);
  }

  .strategy-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out-quart);
  }

  .strategy-card:hover .strategy-card__image {
    transform: scale(1.04);
  }

  .strategy-card__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-lg);
    flex: 1;
  }

  .strategy-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .strategy-card__name {
    font-size: var(--fs-text-lg);
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
  }

  .strategy-card__link {
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out-quart);
  }

  .strategy-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .strategy-card__link:hover { color: var(--color-primary-600); }

  .strategy-card__desc {
    margin: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .strategy-card__returns {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-sm);
    background-color: var(--color-surface-raised);
    border-radius: var(--radius-md);
    margin-top: var(--space-xs);
  }

  .strategy-card__returns-label {
    font-size: var(--fs-text-xs);
    color: var(--color-text-tertiary);
    font-weight: 500;
  }

  .strategy-card__returns-value {
    font-size: var(--fs-text-sm);
    font-weight: 700;
    color: var(--color-primary-700);
  }
</style>
