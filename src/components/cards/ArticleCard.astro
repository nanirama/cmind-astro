---
import Badge from '@components/ui/Badge.astro';
import { formatDateShort } from '@utils/date';

interface Props {
  title: string;
  description: string;
  href: string;
  category: string;
  publishDate: Date;
  readingTime?: string;
  image?: { src: string; alt: string };
  featured?: boolean;
  author?: string;
}

const { title, description, href, category, publishDate, readingTime, image, featured = false, author } = Astro.props;
---

<article class:list={['article-card card card-hover', featured && 'article-card--featured']}>
  {image && (
    <a href={href} class="article-card__image-link" tabindex="-1" aria-hidden="true">
      <div class="article-card__image-wrapper">
        <img
          src={image.src}
          alt={image.alt}
          width="600"
          height="340"
          loading="lazy"
          decoding="async"
          class="article-card__image"
        />
      </div>
    </a>
  )}

  <div class="article-card__content">
    <div class="article-card__meta">
      <Badge variant="primary">{category}</Badge>
      <time datetime={publishDate.toISOString()} class="article-card__date">
        {formatDateShort(publishDate)}
      </time>
      {readingTime && (
        <span class="article-card__reading-time">{readingTime}</span>
      )}
    </div>

    <h2 class="article-card__title">
      <a href={href} class="article-card__title-link">{title}</a>
    </h2>

    <p class="article-card__desc body-sm">{description}</p>

    {author && (
      <div class="article-card__author">
        <span class="body-sm">By {author}</span>
      </div>
    )}
  </div>
</article>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 0;
    text-decoration: none;
  }

  .article-card--featured .article-card__image-wrapper {
    aspect-ratio: 16 / 9;
  }

  .article-card__image-link {
    display: block;
    text-decoration: none;
  }

  .article-card__image-wrapper {
    overflow: hidden;
    aspect-ratio: 3 / 2;
    background-color: var(--color-surface-raised);
  }

  .article-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out-quart);
  }

  .article-card:hover .article-card__image {
    transform: scale(1.04);
  }

  .article-card__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-lg);
    flex: 1;
  }

  .article-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
  }

  .article-card__date,
  .article-card__reading-time {
    font-size: var(--fs-text-xs);
    color: var(--color-text-tertiary);
  }

  .article-card__title {
    font-size: var(--fs-text-lg);
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
  }

  .article-card__title-link {
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out-quart);
  }

  .article-card__title-link:hover {
    color: var(--color-primary-600);
  }

  .article-card__title-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .article-card {
    position: relative;
  }

  .article-card__desc {
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-card__author {
    margin-top: auto;
    padding-top: var(--space-xs);
    border-top: 1px solid var(--color-border);
  }
</style>
