                    <linearGradient
                      id="paint0_linear_5500_6449"
                      x1="7.5"
                      y1="5.90806"
                      x2="19.5145"
                      y2="11.0543"
                      gradientUnits="userSpaceOnUse"
                    >
                      <stop stop-color="#FFC65F" />
                      <stop offset="0.466346" stop-color="#8A6426" />
                      <stop offset="1" stop-color="#FFC65F" />
                    </linearGradient>
                  </defs>
                </svg>
           Who we serve 
          <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  class="rotate-180"
                  xmlns="http://www.w3.org/2000/svg"
