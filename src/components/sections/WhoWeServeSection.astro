      >
        <p
          class="text-[12px] md:text-[14px] font-normal font-inter text-[#EAF5D2] tracking-wide flex flex-row gap-1 items-center"
          aria-hidden="true"
        >
          <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M7.5 4V10M7.5 14V20M10.5 12H16.5"
                    stroke="url(#paint0_linear_5500_6449)"
                    stroke-width="1.5"
                    stroke-linecap="round"
                  />
