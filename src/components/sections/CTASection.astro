---
import Button from '@components/ui/Button.astro';

interface Cta {
  label: string;
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'gold';
}

interface Props {
  eyebrow?: string;
  heading: string;
  body?: string;
  ctas: Cta[];
  variant?: 'default' | 'dark' | 'brand';
}

const { eyebrow, heading, body, ctas, variant = 'brand' } = Astro.props;

const sectionBgClasses = {
  default: 'bg-[var(--color-surface-raised)]',
  dark: 'bg-[var(--color-primary-900)]',
  brand:
    'bg-[linear-gradient(135deg,var(--color-primary-800)_0%,var(--color-primary-600)_60%,var(--color-gold-800)_100%)]',
}[variant];

const headingColorClass =
  variant === 'default'
    ? 'text-[color:var(--color-text-primary)]'
    : 'text-[color:var(--color-text-inverse)]';

const bodyColorClass =
  variant === 'default'
    ? 'text-[color:var(--color-text-secondary)]'
    : 'text-[rgba(255,255,255,0.75)]';
---

<section
  class:list={['relative overflow-hidden py-16 md:py-24 pl-[env(safe-area-inset-left,0px)] pr-[env(safe-area-inset-right,0px)]', sectionBgClasses]}
  aria-label="Call to action"
>
  <div class="container">
    <div class="mx-auto flex max-w-[56rem] flex-col items-center gap-[var(--space-xl)] text-center md:flex-row md:items-center md:justify-between md:text-left">
      <div class="flex flex-1 flex-col gap-[var(--space-xs)]">
        {eyebrow && <p class="eyebrow m-0 text-[color:var(--color-gold-400)]">{eyebrow}</p>}
        <h2
          class:list={[
            'm-0 text-balance font-[family-name:var(--font-serif)] text-[length:var(--fs-h2)]',
            headingColorClass,
          ]}
        >
          {heading}
        </h2>
        {body && (
          <p
            class:list={[
              'm-0 max-w-[52ch] text-pretty text-[length:var(--fs-body-lg)]',
              bodyColorClass,
            ]}
          >
            {body}
          </p>
        )}
      </div>
      {ctas.length > 0 && (
        <div
          class="flex shrink-0 flex-wrap gap-[var(--space-sm)]"
          role="group"
          aria-label="Call to action buttons"
        >
          {ctas.map((cta) => (
            <Button href={cta.href} variant={cta.variant ?? 'gold'} size="lg">
              {cta.label}
            </Button>
          ))}
        </div>
      )}
    </div>
  </div>
</section>