---
import FaqAccordion from '@components/ui/FaqAccordion';

interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  viewAllHref?: string;
  contactHref?: string;
  faqs: FAQ[];
}

const {
  heading = 'Frequently Asked Questions',
  viewAllHref = '/faqs',
  contactHref = '/contact',
  faqs,
} = Astro.props;
---

<section
  class="w-full relative overflow-hidden bg-[#F4F2EA] py-[48px] lg:py-[80px]"
  aria-labelledby="faq-heading"
>
  <!-- Warm golden radial gradient — bottom-center -->
  <div
    aria-hidden="true"
    style="position: absolute; left: 50%; bottom: -200px; transform: translateX(-50%); width: 800px; height: 800px; border-radius: 50%; background: radial-gradient(circle, rgba(210,160,60,0.3) 0%, rgba(237,234,222,0) 65%); pointer-events: none;"
  ></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 flex flex-col lg:block">

    <!-- Top row: heading + View all FAQs -->
    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between mb-8 lg:mb-12 items-center text-center lg:text-left">
      <h2
        id="faq-heading"
        class="font-noto text-[24px] lg:text-[48px] font-medium leading-[1.1] tracking-[-0.03em] text-black m-0"
      >
        {heading}
      </h2>
      <a
        href={viewAllHref}
        class="hidden lg:inline-flex items-center gap-[6px] font-inter text-[15px] font-medium text-black underline underline-offset-4 mt-2"
      >
        View all FAQs
        <svg
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path
            d="M4 12L12 4M12 4H6M12 4V10"
            stroke="#000000"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
    </div>

    <div class="flex flex-col lg:flex-row items-start justify-between gap-10">

      <!-- Left — can't find answer (HIDDEN ON MOBILE) -->
      <div class="hidden lg:flex w-full lg:w-[320px] shrink-0 flex-col gap-6 pt-2">
        <p class="font-noto text-[40px] font-medium leading-[1.3] text-black/55 m-0">
          Can't find <br /> your answer?
        </p>
        <a
          href={contactHref}
          class="inline-flex items-center justify-center px-7 py-3 bg-black text-white font-inter text-[15px] font-medium rounded-lg w-fit"
        >
          Contact Us
        </a>
      </div>

      <!-- Right — FAQ accordion React island -->
      <FaqAccordion client:visible faqs={faqs} />

    </div>

    <!-- MOBILE ONLY Contact Button -->
    <div class="flex lg:hidden w-full justify-center mt-8">
      <a
        href={contactHref}
        class="inline-flex items-center justify-center px-6 py-3 bg-[#0A0A0A] text-white font-inter text-[15px] font-medium rounded-[8px]"
      >
        Contact Us
      </a>
    </div>

  </div>
</section>
