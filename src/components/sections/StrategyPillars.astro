---
interface Pillar {
  icon: string;
  title: string;
  description: string;
}

interface Props {
  heading: string;
  subheading?: string;
  pillars: Pillar[];
}

const { heading, subheading, pillars } = Astro.props;

const ICONS: Record<string, string> = {
  'mega-trends':
    '<path d="M12 3v5M12 16v5M5.6 5.6l3.5 3.5M14.9 14.9l3.5 3.5M3 12h5M16 12h5M5.6 18.4l3.5-3.5M14.9 9.1l3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>',
  shield:
    '<path d="M12 3.5l7 2.6v5.4c0 4.4-3 7.9-7 9-4-1.1-7-4.6-7-9V6.1l7-2.6Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>',
  'trending-up':
    '<path d="M4 16l5-5 4 4 7-8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M15 7h5v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>',
  alert:
    '<circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.5"/><path d="M12 8v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="12" cy="16" r="0.9" fill="currentColor"/>',
};

function iconMarkup(icon: string) {
  return ICONS[icon] ?? ICONS['mega-trends'];
}
---

<section
  class="section overflow-x-hidden py-16 md:py-24 bg-[var(--color-dark-green-900)] pl-[env(safe-area-inset-left,0px)] pr-[env(safe-area-inset-right,0px)]"
  aria-labelledby="sp-heading"
>
  <div class="container px-4">
    <h2
      id="sp-heading"
      class="m-0 mb-[var(--space-md)] max-w-[26ch] text-[color:var(--color-text-inverse)]"
    >
      {heading}
    </h2>

    {subheading && (
      <p class="m-0 mb-[var(--space-2xl)] max-w-[56ch] font-sans text-[length:var(--fs-body-base)] leading-[var(--lh-body-base)] text-[color:var(--color-beige-300)]">
        {subheading}
      </p>
    )}

    <div class="grid grid-cols-1 gap-[var(--space-md)] md:grid-cols-2 md:gap-[var(--space-lg)]">
      {pillars.map((pillar) => (
        <div class="rounded-[var(--radius-lg)] border border-[#093F23] bg-[#102519] p-[var(--space-lg)]">
          <svg
            class="mb-[var(--space-md)] text-[color:var(--color-gold-500)]"
            width="44"
            height="44"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
            set:html={iconMarkup(pillar.icon)}
          />
          <h3 class="m-0 mb-[var(--space-xs)] font-[family-name:var(--font-serif)] text-[length:var(--fs-h5)] font-medium leading-[var(--lh-h5)] text-[color:var(--color-text-inverse)]">
            {pillar.title}
          </h3>
          <p class="m-0 max-w-[40ch] font-sans text-[length:var(--fs-body-base)] leading-[var(--lh-body-base)] text-[color:var(--color-beige-300)]">
            {pillar.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>