---
import { Image } from 'astro:assets';

interface Feature {
  title: string;
  description: string;
  image: string;
  imageWidth?: number;
  imageHeight?: number;
}

interface Props {
  heading: string;
  ctaLabel?: string;
  ctaHref?: string;
  features: Feature[];
}

const {
  heading,
  ctaLabel = 'Get Started Today',
  ctaHref = '/get-started',
  features,
} = Astro.props;
---

<section
  class="w-full pt-[48px] md:pt-[120px] pb-[48px] md:pb-[120px] bg-[#EDEADE]"
  aria-label="Our Investment Principles"
>
  <div class="w-full max-w-[1440px] mx-auto px-4 lg:px-[80px]">

    <h2
      class="text-[#0E0E0E] text-[28px] md:text-[48px] font-medium font-noto leading-[1.2] tracking-[-5%] max-w-4xl text-center md:text-left mx-auto md:mx-0 mb-[32px] md:mb-[60px]"
      set:html={heading}
    />

    <div class="relative">
      <div
        data-oip-carousel
        class="flex md:grid md:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5 overflow-x-auto md:overflow-x-visible snap-x snap-mandatory hide-scrollbar pb-2 md:pb-0 relative z-10 mobile-fade-mask"
      >
        {features.map((item) => (
          <article
            class="relative rounded-[16px] bg-[#FCFCF9] p-5 md:p-6 transition-all duration-300 hover:-translate-y-2 hover:shadow-xl h-[260px] md:h-[318px] flex flex-col min-w-[300px] w-[300px] md:w-auto md:min-w-0 snap-center shrink-0"
          >
            <div class="absolute top-6 left-0 right-0 h-[140px] md:h-[160px] flex items-center justify-center pointer-events-none px-6">
              <div class="relative w-full h-full flex items-center justify-center">
                <Image
                  src={item.image}
                  alt={item.title}
                  width={item.imageWidth ?? 300}
                  height={item.imageHeight ?? 200}
                  format="webp"
                  quality={85}
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 w-full h-full object-contain object-top"
                />
              </div>
            </div>

            <div class="mt-auto relative z-10">
              <h3 class="font-noto font-medium text-[20px] leading-[1.2] text-[#0E0E0E] mb-2 tracking-tight">
                {item.title}
              </h3>
              <p class="text-[16px] font-inter font-normal leading-[1.4] md:leading-[1.5] text-[#555555]">
                {item.description}
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- Mobile pagination dots (updated by scroll script) -->
    <div class="flex justify-center gap-[6px] mt-4 md:hidden" aria-hidden="true">
      {features.map((_, i) => (
        <div
          data-oip-dot
          class={`w-[8px] h-[8px] rounded-full transition-colors duration-300 ${i === 0 ? 'bg-[#999999]' : 'bg-[#D6D6D6]'}`}
        ></div>
      ))}
    </div>

    <div class="flex justify-center mt-8 md:mt-[60px]">
      <a
        href={ctaHref}
        class="bg-[#0E0E0E] text-white font-medium font-inter text-[16px] px-8 py-4 rounded-[12px] hover:bg-black transition-colors shadow-lg"
      >
        {ctaLabel}
      </a>
    </div>

  </div>
</section>

<style>
  .hide-scrollbar::-webkit-scrollbar { display: none; }
  .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

  @media (max-width: 767px) {
    .mobile-fade-mask {
      -webkit-mask-image: linear-gradient(to right, black 85%, transparent 100%);
      mask-image: linear-gradient(to right, black 85%, transparent 100%);
    }
  }
</style>

<script>
  const carousel = document.querySelector('[data-oip-carousel]') as HTMLElement | null;
  const dots = document.querySelectorAll('[data-oip-dot]');

  if (carousel && dots.length > 0) {
    carousel.addEventListener('scroll', () => {
      const { scrollLeft, scrollWidth, clientWidth } = carousel;
      const totalScroll = scrollWidth - clientWidth;
      if (totalScroll <= 0) return;

      const ratio = scrollLeft / totalScroll;
      const count = dots.length;
      const newIndex = Math.min(count - 1, Math.max(0, Math.round(ratio * (count - 1))));

      dots.forEach((dot, i) => {
        dot.classList.toggle('bg-[#999999]', i === newIndex);
        dot.classList.toggle('bg-[#D6D6D6]', i !== newIndex);
      });
    }, { passive: true });
  }
</script>
