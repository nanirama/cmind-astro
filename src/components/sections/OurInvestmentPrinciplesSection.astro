---
import { Image } from 'astro:assets';

interface Feature {
  title: string;
  description: string;
  image: string;
  imageWidth?: number;
  imageHeight?: number;
}

interface Props {
  heading: string;
  ctaLabel?: string;
  ctaHref?: string;
  features: Feature[];
}

const {
  heading,
  ctaLabel = 'Get Started Today',
  ctaHref = '/get-started',
  features,
} = Astro.props;
---

<section
  class="w-full overflow-x-hidden bg-[#EDEADE] pb-[48px] pl-[env(safe-area-inset-left,0px)] pr-[env(safe-area-inset-right,0px)] pt-[48px] md:pb-[120px] md:pt-[120px]"
  aria-label="Our Investment Principles"
>
  <div class="mx-auto w-full max-w-[1440px] px-4 lg:px-[80px]">

    <h2
      class="mx-auto mb-[32px] max-w-4xl text-center font-noto text-[28px] font-medium leading-[1.2] tracking-[-5%] text-[#0E0E0E] md:mx-0 md:mb-[60px] md:text-left md:text-[48px]"
      set:html={heading}
    />

    <div class="relative max-md:[-webkit-mask-image:linear-gradient(to_right,black_85%,transparent_100%)] max-md:[mask-image:linear-gradient(to_right,black_85%,transparent_100%)]">
      <div
        data-oip-carousel
        role="region"
        aria-label="Our investment principles"
        tabindex="0"
        class="relative z-10 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-500 max-md:[-webkit-mask-image:linear-gradient(to_right,black_85%,transparent_100%)] max-md:[mask-image:linear-gradient(to_right,black_85%,transparent_100%)] [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden md:grid md:grid-cols-2 md:gap-5 md:overflow-x-visible md:pb-0 lg:grid-cols-4"
      >
        {features.map((item) => (
          <article
            class="relative flex h-[260px] w-[300px] min-w-[300px] shrink-0 snap-center flex-col rounded-[16px] bg-[#FCFCF9] p-5 transition-all duration-300 hover:-translate-y-2 hover:shadow-xl md:h-[318px] md:w-auto md:min-w-0 md:p-6"
          >
            <div class="pointer-events-none absolute left-0 right-0 top-6 flex h-[140px] items-center justify-center px-6 md:h-[160px]">
              <div class="relative flex h-full w-full items-center justify-center">
                <Image
                  src={item.image}
                  alt={item.title}
                  width={item.imageWidth ?? 300}
                  height={item.imageHeight ?? 200}
                  format="webp"
                  quality={85}
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 h-full w-full object-contain object-top"
                />
              </div>
            </div>

            <div class="relative z-10 mt-auto">
              <h3 class="mb-2 font-noto text-[20px] font-medium leading-[1.2] tracking-tight text-[#0E0E0E]">
                {item.title}
              </h3>
              <p class="font-inter text-[16px] font-normal leading-[1.4] text-[#555555] md:leading-[1.5]">
                {item.description}
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- Mobile pagination dots (updated by scroll script) -->
    <div class="mt-4 flex justify-center gap-[6px] md:hidden" aria-hidden="true">
      {features.map((_, i) => (
        <div
          data-oip-dot
          class={`w-[8px] h-[8px] rounded-full transition-colors duration-300 ${i === 0 ? 'bg-[#999999]' : 'bg-[#D6D6D6]'}`}
        ></div>
      ))}
    </div>

    <div class="mt-8 flex justify-center md:mt-[60px]">
      <a
        href={ctaHref}
        class="rounded-[12px] bg-[#0E0E0E] px-8 py-4 font-inter text-[16px] font-medium text-white shadow-lg transition-colors hover:bg-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-500"
      >
        {ctaLabel}
      </a>
    </div>

  </div>
</section>

<script>
  const carousel = document.querySelector('[data-oip-carousel]') as HTMLElement | null;
  const dots = document.querySelectorAll('[data-oip-dot]');

  if (carousel && dots.length > 0) {
    carousel.addEventListener('scroll', () => {
      const { scrollLeft, scrollWidth, clientWidth } = carousel;
      const totalScroll = scrollWidth - clientWidth;
      if (totalScroll <= 0) return;

      const ratio = scrollLeft / totalScroll;
      const count = dots.length;
      const newIndex = Math.min(count - 1, Math.max(0, Math.round(ratio * (count - 1))));

      dots.forEach((dot, i) => {
        dot.classList.toggle('bg-[#999999]', i === newIndex);
        dot.classList.toggle('bg-[#D6D6D6]', i !== newIndex);
      });
    }, { passive: true });
  }
</script>
