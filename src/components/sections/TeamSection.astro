---
import SectionHeader from '@components/ui/SectionHeader.astro';

interface TeamMember {
  name: string;
  role: string;
  bio?: string;
  image?: { src: string; alt: string };
  linkedin?: string;
  twitter?: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  members: TeamMember[];
}

const { eyebrow, heading, members } = Astro.props;
---

<section class="team-section section" aria-label={heading ?? 'Our team'}>
  <div class="container">
    {(eyebrow || heading) && (
      <SectionHeader eyebrow={eyebrow} heading={heading} align="center" />
    )}
    <div class="team-grid" role="list" aria-label="Team members">
      {members.map((member) => (
        <article class="team-card" role="listitem">
          <div class="team-card__image-wrapper">
            {member.image ? (
              <img
                src={member.image.src}
                alt={member.image.alt}
                width="280"
                height="280"
                loading="lazy"
                decoding="async"
                class="team-card__image"
              />
            ) : (
              <div class="team-card__image-placeholder" aria-hidden="true">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
              </div>
            )}
          </div>
          <div class="team-card__content">
            <h3 class="team-card__name">{member.name}</h3>
            <p class="team-card__role">{member.role}</p>
            {member.bio && <p class="team-card__bio body-sm">{member.bio}</p>}
            <div class="team-card__social" aria-label={`${member.name}'s social links`}>
              {member.linkedin && (
                <a href={member.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`${member.name} on LinkedIn`} class="team-card__social-link">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                </a>
              )}
              {member.twitter && (
                <a href={member.twitter} target="_blank" rel="noopener noreferrer" aria-label={`${member.name} on Twitter`} class="team-card__social-link">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.748l7.73-8.835L1.254 2.25H8.08l4.258 5.636zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                  </svg>
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .team-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
    margin-top: var(--space-2xl);
  }

  @media (min-width: 768px) {
    .team-grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (min-width: 1024px) {
    .team-grid { grid-template-columns: repeat(4, 1fr); }
  }

  .team-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .team-card__image-wrapper {
    aspect-ratio: 1;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background-color: var(--color-surface-raised);
  }

  .team-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out-quart);
  }

  .team-card:hover .team-card__image {
    transform: scale(1.04);
  }

  .team-card__image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-border-strong);
  }

  .team-card__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  .team-card__name {
    font-size: var(--fs-text-md);
    font-weight: 600;
    margin: 0;
    color: var(--color-text-primary);
  }

  .team-card__role {
    font-size: var(--fs-text-sm);
    color: var(--color-gold-600);
    font-weight: 500;
    margin: 0;
  }

  .team-card__bio {
    margin: var(--space-3xs) 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .team-card__social {
    display: flex;
    gap: var(--space-xs);
    margin-top: var(--space-xs);
  }

  .team-card__social-link {
    display: flex;
    align-items: center;
    color: var(--color-text-tertiary);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out-quart);
  }

  .team-card__social-link:hover {
    color: var(--color-primary-600);
  }
</style>
