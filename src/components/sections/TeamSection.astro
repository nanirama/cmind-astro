---
import SectionHeader from '@components/ui/SectionHeader.astro';

interface TeamMember {
  name: string;
  role: string;
  bio?: string;
  image?: { src: string; alt: string };
  linkedin?: string;
  twitter?: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  members: TeamMember[];
}

const { eyebrow, heading, members } = Astro.props;
---

<section class="section py-16 md:py-24 overflow-x-hidden pl-[env(safe-area-inset-left,0px)] pr-[env(safe-area-inset-right,0px)]" aria-label={heading ?? 'Our team'}>
  <div class="container">
    {(eyebrow || heading) && (
      <SectionHeader eyebrow={eyebrow} heading={heading} align="center" />
    )}
    <div
      class="mt-[var(--space-2xl)] grid grid-cols-2 gap-[var(--space-lg)] md:grid-cols-3 lg:grid-cols-4"
      role="list"
      aria-label="Team members"
    >
      {members.map((member) => (
        <article class="group flex flex-col gap-[var(--space-md)]" role="listitem">
          <div class="aspect-square overflow-hidden rounded-[var(--radius-xl)] bg-[var(--color-surface-raised)]">
            {member.image ? (
              <img
                src={member.image.src}
                alt={member.image.alt}
                width="280"
                height="280"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-[var(--duration-slow)] ease-[var(--ease-out-quart)] group-hover:scale-[1.04]"
              />
            ) : (
              <div
                class="flex h-full w-full items-center justify-center text-[color:var(--color-border-strong)]"
                aria-hidden="true"
              >
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
              </div>
            )}
          </div>
          <div class="flex flex-col gap-[var(--space-3xs)]">
            <h3 class="m-0 text-[length:var(--fs-body-base)] font-semibold text-[color:var(--color-text-primary)]">
              {member.name}
            </h3>
            <p class="m-0 text-[length:var(--fs-body-sm)] font-medium text-[color:var(--color-gold-600)]">
              {member.role}
            </p>
            {member.bio && (
              <p class="body-sm mt-[var(--space-3xs)] line-clamp-3">
                {member.bio}
              </p>
            )}
            <div
              class="mt-[var(--space-xs)] flex gap-[var(--space-xs)]"
              aria-label={`${member.name}'s social links`}
            >
              {member.linkedin && (
                <a
                  href={member.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${member.name} on LinkedIn`}
                  class="flex items-center text-[color:var(--color-text-tertiary)] no-underline transition-colors duration-[var(--duration-fast)] ease-[var(--ease-out-quart)] hover:text-[color:var(--color-primary-600)]"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                </a>
              )}
              {member.twitter && (
                <a
                  href={member.twitter}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${member.name} on Twitter`}
                  class="flex items-center text-[color:var(--color-text-tertiary)] no-underline transition-colors duration-[var(--duration-fast)] ease-[var(--ease-out-quart)] hover:text-[color:var(--color-primary-600)]"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.748l7.73-8.835L1.254 2.25H8.08l4.258 5.636zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                  </svg>
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>