---
import Button from '@components/ui/Button.astro';

interface Props {
  eyebrow?: string;
  heading?: string;
  body: string;
  layout?: 'centered' | 'left' | 'two-col';
  image?: { src: string; alt: string; width?: number; height?: number };
  imagePosition?: 'left' | 'right';
  cta?: { label: string; href: string; variant?: 'primary' | 'secondary' | 'ghost' | 'gold' };
}

const {
  eyebrow,
  heading,
  body,
  layout = 'centered',
  image,
  imagePosition = 'right',
  cta,
} = Astro.props;

const innerLayoutClasses =
  layout === 'centered'
    ? 'mx-auto max-w-[52rem] text-center'
    : layout === 'left'
      ? 'max-w-[52rem]'
      : '';

const innerImageClasses = image
  ? 'grid grid-cols-1 items-center gap-[var(--space-2xl)] md:grid-cols-2'
  : '';
---

<section
  class:list={['overflow-x-hidden py-16 md:py-24 pl-[env(safe-area-inset-left,0px)] pr-[env(safe-area-inset-right,0px)]']}
  aria-label={heading ?? 'Content section'}
>
  <div class="container">
    <div class:list={['flex flex-col', innerLayoutClasses, innerImageClasses]}>
      <div class="flex flex-col gap-[var(--space-sm)]">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        {heading && <h2 class="m-0 text-balance">{heading}</h2>}
        <div class="body-lg m-0" set:html={body} />
        {cta && (
          <Button
            href={cta.href}
            variant={cta.variant ?? 'primary'}
            class:list={[layout === 'centered' && 'mt-[var(--space-md)]']}
          >
            {cta.label}
          </Button>
        )}
        <slot />
      </div>

      {image && (
        <div
          class:list={[
            'aspect-[4/3] overflow-hidden rounded-[var(--radius-xl)]',
            imagePosition === 'left' && 'md:order-first',
          ]}
        >
          <img
            src={image.src}
            alt={image.alt}
            width={image.width ?? 600}
            height={image.height ?? 450}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover"
          />
        </div>
      )}
    </div>
  </div>
</section>