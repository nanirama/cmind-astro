---
import Button from '@components/ui/Button.astro';

interface Props {
  eyebrow?: string;
  heading?: string;
  body: string;
  layout?: 'centered' | 'left' | 'two-col';
  image?: { src: string; alt: string; width?: number; height?: number };
  imagePosition?: 'left' | 'right';
  cta?: { label: string; href: string; variant?: 'primary' | 'secondary' | 'ghost' | 'gold' };
}

const {
  eyebrow,
  heading,
  body,
  layout = 'centered',
  image,
  imagePosition = 'right',
  cta,
} = Astro.props;
---

<section class:list={['content-section section', `content-section--${layout}`]} aria-label={heading ?? 'Content section'}>
  <div class="container">
    <div class:list={['content-section__inner', image && `content-section__inner--image-${imagePosition}`]}>
      <div class="content-section__text">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        {heading && <h2 class="text-balance">{heading}</h2>}
        <div class="body-lg content-section__body" set:html={body} />
        {cta && (
          <Button href={cta.href} variant={cta.variant ?? 'primary'} class="content-section__cta">
            {cta.label}
          </Button>
        )}
        <slot />
      </div>

      {image && (
        <div class="content-section__image-wrapper">
          <img
            src={image.src}
            alt={image.alt}
            width={image.width ?? 600}
            height={image.height ?? 450}
            loading="lazy"
            decoding="async"
            class="content-section__image"
          />
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .content-section--centered .content-section__inner {
    max-width: 52rem;
    margin-inline: auto;
    text-align: center;
  }

  .content-section--centered .content-section__cta {
    margin-top: var(--space-md);
  }

  .content-section--left .content-section__inner {
    max-width: 52rem;
  }

  .content-section__inner--image-right,
  .content-section__inner--image-left {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
    align-items: center;
  }

  @media (min-width: 768px) {
    .content-section__inner--image-right {
      grid-template-columns: 1fr 1fr;
    }
    .content-section__inner--image-left {
      grid-template-columns: 1fr 1fr;
    }
    .content-section__inner--image-left .content-section__image-wrapper {
      order: -1;
    }
  }

  .content-section__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .content-section__text h2 { margin: 0; }
  .content-section__body { margin: 0; }

  .content-section__image-wrapper {
    border-radius: var(--radius-xl);
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .content-section__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
