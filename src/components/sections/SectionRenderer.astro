---
/**
 * SectionRenderer – content-driven section dispatch with render-cost
 * deferral. Hero renders eager/unboxed to avoid CLS; everything below
 * uses content-visibility to skip layout/paint until near viewport.
 */
import StatsSection from './StatsSection.astro';
import FAQSection from './FAQSection.astro';
import HomeHeroSection from './HomeHeroSection/index.astro';
import WhoWeServeSection from './WhoWeServeSection.astro';
import OurInvestmentPrinciplesSection from './OurInvestmentPrinciplesSection.astro';
import CapitalmindAdvantageSection from './CapitalmindAdvantageSection.astro';
import MeetOurFounderSection from './MeetOurFounderSection.astro';
import TestimonialsSection from './TestimonialsSection.astro';
import LatestMarketUpdatesSection from './LatestMarketUpdatesSection.astro';
import AudiencepageHeroSection from './AudiencepageHeroSection.astro';
import WealthGapsSection from './WealthGapsSection.astro';
import HowCapitalMindHelpsSection from './HowCapitalMindHelpsSection.astro';
import PmsFitSection from './PmsFitSection.astro';
import PmsStrategyExplorerSection from './PmsStrategyExplorerSection.astro';
import WealthJourneySteps from './WealthJourneySteps.astro';
import ReportingDashboardFeatures from './ReportingDashboardFeatures.astro';
import StrategyPillars from './StrategyPillars.astro';
import StrategyThemesShowcase from './StrategyThemesShowcase.astro';
import PerformanceComparisonChart from './PerformanceComparisonChart.astro';
import InvestorJourney from './InvestorJourney.astro';
import Process from './Process.astro';

type Section = Record<string, unknown> & { type: string };
interface Props {
  sections: Section[];
}

const { sections } = Astro.props;

const registry: Record<string, any> = {
  hero: HomeHeroSection,
  whoweserve: WhoWeServeSection,
  ourinvestmentprinciples: OurInvestmentPrinciplesSection,
  //capitalmindadvantage: CapitalmindAdvantageSection,
  //meetourfounder: MeetOurFounderSection,
  testimonialssection: TestimonialsSection,
  //latestmarketupdates: LatestMarketUpdatesSection,
  audiencepage_hero: AudiencepageHeroSection,
  stats: StatsSection,
  // wealthgaps: WealthGapsSection,
  // howcapitalmindshelps: HowCapitalMindHelpsSection,
  // pmsfit: PmsFitSection,
  // pmsstrategyexplorer: PmsStrategyExplorerSection,
  // wealthjourneysteps: WealthJourneySteps,
  // reportingdashboardfeatures: ReportingDashboardFeatures,
  // strategypillars: StrategyPillars,
  // strategythemesshowcase: StrategyThemesShowcase,
  // performancecomparisonchart: PerformanceComparisonChart,
  // investorjourney: InvestorJourney,
  // process: Process,
  // faq: FAQSection,
};

// Rough average height per section type, used as contain-intrinsic-size
// so content-visibility doesn't collapse offscreen sections to 0px
// (which would cause scrollbar jumpiness / bad IntersectionObserver behavior).
const sizeHints: Record<string, string> = {
  faq: '800px',
  performancecomparisonchart: '600px',
  testimonialssection: '500px',
  default: '640px',
};
---

{sections.map((section, index) => {
  const Component = registry[section.type];
  if (!Component) return null;

  // Hero: render fully eager, no wrapper, no content-visibility.
  // Wrapping the LCP element breaks priority hints and can itself cause CLS.
  if (index === 0) {
    return <Component {...(section as any)} />;
  }

  const isNearFold = index <= 2;
  const height = sizeHints[section.type] ?? sizeHints.default;

  return (
    <div
      class:list={[isNearFold ? '' : 'cv-auto']}
      style={isNearFold ? undefined : `content-visibility:auto;contain-intrinsic-size:0 ${height};`}
    >
      <Component {...(section as any)} />
    </div>
  );
})}