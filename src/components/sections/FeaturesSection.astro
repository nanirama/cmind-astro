---
import SectionHeader from '@components/ui/SectionHeader.astro';
import Button from '@components/ui/Button.astro';

interface Feature {
  icon?: string;
  heading: string;
  description: string;
  link?: { label: string; href: string };
}

interface Props {
  eyebrow?: string;
  heading?: string;
  body?: string;
  features: Feature[];
  layout?: 'grid' | 'list' | 'alternating';
  columns?: 2 | 3 | 4;
}

const { eyebrow, heading, body, features, columns = 3 } = Astro.props;

const colClass = {
  2: 'sm:grid-cols-2 lg:grid-cols-2',
  3: 'sm:grid-cols-2 lg:grid-cols-3',
  4: 'sm:grid-cols-2 lg:grid-cols-4',
}[columns];
---

<section class="section py-16 md:py-24 overflow-x-hidden pl-[env(safe-area-inset-left,0px)] pr-[env(safe-area-inset-right,0px)]" aria-label={heading ?? 'Features'}>
  <div class="container">
    {(eyebrow || heading || body) && (
      <SectionHeader eyebrow={eyebrow} heading={heading} body={body} align="center" />
    )}

    <div class:list={['mt-[var(--space-2xl)] grid grid-cols-1 gap-[var(--space-lg)]', colClass]}>
      {features.map((feature) => (
        <article class="group flex flex-col gap-[var(--space-sm)] rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-surface)] p-[var(--space-lg)] transition-[border-color,box-shadow] duration-[var(--duration-base)] ease-[var(--ease-out-quart)] hover:border-[var(--color-primary-300)] hover:shadow-[var(--shadow-md)]">
          {feature.icon && (
            <div
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-[var(--radius-md)] bg-[var(--color-primary-50)] text-[color:var(--color-primary-600)]"
              aria-hidden="true"
            >
              <span set:html={feature.icon} />
            </div>
          )}
          <h3 class="m-0 text-[length:var(--fs-body-lg)] font-semibold text-[color:var(--color-text-primary)]">
            {feature.heading}
          </h3>
          <p class="body-base m-0 flex-1">{feature.description}</p>
          {feature.link && (
            <Button href={feature.link.href} variant="ghost" size="sm" class="self-start px-0">
              {feature.link.label}
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </Button>
          )}
        </article>
      ))}
    </div>
  </div>
</section>