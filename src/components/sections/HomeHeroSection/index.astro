---
import { Image } from 'astro:assets';
// import HeroImageSection from './HeroImageSection';
---

<div class="w-full">
  <section class="relative overflow-hidden pt-[80px] md:pt-[180px]">
    <div class="mx-auto max-w-7xl px-4 pt-6">
      <div class="mx-auto max-w-3xl text-center">
        <!-- Heading -->
        <h1
          class="mx-auto font-noto text-[28px] font-medium leading-[1.2] tracking-tighter text-[#111111] sm:leading-[1.1] md:text-[48px] lg:text-[60px]"
          style="font-stretch: condensed;"
        >
          <span>Invest Like Capital Should Be Managed, Not Sold.</span>
        </h1>

        <!-- Mobile-only Hero Image (inserted between heading and description) -->
        <div class="-mx-4 my-8 block md:hidden">
          <Image
          src="/images/homeheroimage-mobile.png"
          alt="Capitalmind wealth management platform dashboard showing systematic investment strategies and portfolio analytics"
          width={603}
          height={375}
          format="webp"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="pointer-events-none h-auto w-full select-none object-contain"
        />
        </div>

        <!-- Description -->
        <p class="mx-auto mt-4 max-w-2xl font-inter text-[16px] font-normal leading-[1.5] text-[#6F6F6F] md:mt-10 md:text-[20px]">
          Capitalmind builds portfolios the way institutions do, where
          allocation is deliberate, decisions are systematic, and portfolios
          are built to endure across market cycles.
        </p>

        <!-- Buttons -->
        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <button class="rounded-[8px] bg-[#0E100F] px-8 py-3.5 font-inter text-[16px] font-medium text-white">
            <span class="md:hidden">Manage My Wealth</span>
            <span class="hidden md:inline">Manage My Investments</span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Desktop-only Hero Image -->
  <div class="hidden md:block">
    <div class="flex w-full items-center justify-center px-4 md:px-0">
      <div class="relative mx-auto w-full max-w-[923px]">
        <Image
          src="/images/homeheroimg-desktop-2.png"
          alt="Capitalmind wealth management platform dashboard showing systematic investment strategies and portfolio analytics"
          width={903}
          height={453}
          format="webp"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="pointer-events-none h-auto w-full select-none object-contain"
        />
      </div>
    </div>
  </div>

  <div class="mx-auto flex max-w-7xl flex-row items-start justify-between gap-2 px-4 py-12 md:items-center md:gap-0 md:py-16">
    <div class="flex w-1/3 flex-col items-center gap-1 text-center md:gap-2">
      <h3 class="font-noto text-[20px] font-medium leading-none tracking-tight text-[#0E0E0E] md:text-[56px]">900+</h3>
      <p class="font-inter text-[13px] leading-tight text-[#6F6F6F] md:text-[16px] md:leading-normal">Entrepreneurs<br class="block md:hidden" /> Assisted</p>
    </div>
    <div class="flex w-1/3 flex-col items-center gap-1 text-center md:gap-2">
      <h3 class="font-noto text-[20px] font-medium leading-none tracking-tight text-[#0E0E0E] md:text-[56px]">1400+</h3>
      <p class="font-inter text-[13px] leading-tight text-[#6F6F6F] md:text-[16px] md:leading-normal">UHNI Wealth<br class="block md:hidden" /> Managed</p>
    </div>
    <div class="flex w-1/3 flex-col items-center gap-1 text-center md:gap-2">
      <h3 class="font-noto text-[20px] font-medium leading-none tracking-tight text-[#0E0E0E] md:text-[56px]">10Cr+</h3>
      <p class="font-inter text-[13px] leading-tight text-[#6F6F6F] md:text-[16px] md:leading-normal">Average HNI<br class="block md:hidden" /> Portfolio</p>
    </div>
  </div>
</div>
