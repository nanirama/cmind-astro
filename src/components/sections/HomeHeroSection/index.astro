---
import { Image } from "astro:assets";

interface Cta {
  label: string;
  href: string;
  variant?: "primary" | "secondary" | "ghost";
  external?: boolean;
}

interface HeroImage {
  src: string;
  alt: string;
  width?: number;
  height?: number;
}
interface BackgroundImage {
  src: string;
  alt?: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  subheading?: string;
  body?: string;
  ctas?: Cta[];
  image?: HeroImage;
  backgroundImage?: BackgroundImage;
}

const { eyebrow, heading, subheading, body,  backgroundImage, ctas = [], image } = Astro.props;
---

<div class="w-full relative">
  <section class="relative overflow-x-hidden pl-[env(safe-area-inset-left,0px)] pr-[env(safe-area-inset-right,0px)] pt-[80px] pb-12 lg:pt-[180px]">
    <div class="relative w-full h-full">
     {backgroundImage && (
    <Image
      src={backgroundImage.src}
      alt=""
      width={1600}
      height={500}
      aria-hidden="true"
      loading="eager"
      decoding="async"
      class="absolute inset-0 z-0 h-full w-full object-cover"
    />
  )}
  </div>
    <div class="mx-auto max-w-7xl px-4">
      <div class="mx-auto max-w-6xl text-center pt-8">
        {
          eyebrow && (
            <p class="mb-4 font-inter text-[14px] font-medium uppercase tracking-wide text-[#6F6F6F]">
              {eyebrow}
            </p>
          )
        }

        <!-- Heading -->
        <h1
          class="mx-auto font-noto text-[28px] font-medium leading-[1.2] tracking-tighter text-[#111111] [font-stretch:condensed] sm:leading-[1.1] md:text-[48px] lg:text-[60px]"
        >
          <span>{heading}</span>
        </h1>

        <!-- Mobile-only Hero Image (inserted between heading and description) -->
        {
          image && (
            <div class="xl:-mx-4 my-8 block xl:hidden">
              <Image
                src={image.src}
                alt={image.alt}
                width={image.width ?? 1280}
                height={image.height ?? 453}
                format="webp"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="pointer-events-none h-auto w-full select-none object-contain"
              />
            </div>
          )
        }

        {
          subheading && (
            <p class="mx-auto mt-4 max-w-2xl font-inter text-[18px] font-medium leading-[1.5] text-[#111111] md:text-[22px]">
              {subheading}
            </p>
          )
        }

        <!-- Description -->
        {
          body && (
            <p class="mx-auto mt-4 max-w-2xl font-inter text-[16px] font-normal leading-[1.5] text-[#6F6F6F] md:mt-10 md:text-[20px]">
              {body}
            </p>
          )
        }

        <!-- Buttons -->
        {
          ctas.length > 0 && (
            <div class="mt-12 flex flex-col items-center justify-center gap-4 sm:flex-row">
              {ctas.map((cta) => (
                <a
                  href={cta.href}
                  target={cta.external ? "_blank" : undefined}
                  rel={cta.external ? "noopener noreferrer" : undefined}
                  class={
                    cta.variant === "secondary"
                      ? "rounded-[8px] border border-[#0E100F] px-8 py-3.5 font-inter text-[16px] font-medium text-[#0E100F] sm:w-auto min-w-[250px]"
                      : "rounded-[8px] bg-[#0E100F] px-8 py-3.5 font-inter text-[16px] font-medium text-white sm:w-auto min-w-[250px]"
                  }
                >
                  {cta.label}
                </a>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- Desktop-only Hero Image -->
  {
    image && (
      <div class="hidden xl:block py-6">
        <div class="flex w-full items-center justify-center px-4 md:px-0 max-w-7xl mx-auto">
          <div
            class="relative mx-auto w-auto !min-w-auto xl:max-w-min"
          >
            <Image
              src={image.src}
              alt={image.alt}
              width={image.width ?? 923}
              height={image.height ?? 453}
              format="webp"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="pointer-events-none h-auto w-auto select-none object-cover"
            />
          </div>
        </div>
      </div>
    )
  }
</div>
