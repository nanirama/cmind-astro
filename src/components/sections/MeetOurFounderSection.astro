---
import { Image } from 'astro:assets';

interface TeamMember {
  name: string;
  role: string;
  image: string;
}

interface Props {
  founderName?: string;
  founderTitle?: string;
  founderImage?: string;
  founderBgImage?: string;
  founderQuote?: string;
  leadershipHeading?: string;
  team?: TeamMember[];
  bookEyebrow?: string;
  bookHeading?: string;
  bookDescription?: string;
  bookPurchaseLabel?: string;
  bookPurchaseHref?: string;
  podcastImage?: string;
}

const {
  founderName      = 'Deepak Shenoy',
  founderTitle     = 'Founder @Capitalmind',
  founderImage     = '/images/founder-img.png',
  founderBgImage   = '/images/founder-imgbg.png',
  founderQuote     = '"Good investing is not about finding the next big thing, but about staying disciplined, managing risk, and letting compounding do its work."',
  leadershipHeading = '20+ years of taught leadership',
  team             = [],
  bookEyebrow      = 'Written by Deepak Shenoy',
  bookHeading      = 'Money Wise: Timeless Lessons on Building Wealth',
  bookDescription  = 'Wealth is not just about adding zeroes to your net worth but having enough to live an unconstrained life.',
  bookPurchaseLabel = 'Purchase Book',
  bookPurchaseHref = '#'
} = Astro.props;
---

<section class="overflow-x-hidden bg-[#121B14] py-[48px] pl-[env(safe-area-inset-left,0px)] pr-[env(safe-area-inset-right,0px)] lg:py-32">

  <!-- Desktop version -->
  <div class="mx-auto hidden max-w-7xl px-4 lg:block">

    <h2 class="mb-8 font-serif text-3xl font-normal tracking-[-0.02em] text-white md:text-[48px]">
      Meet Our Founder
    </h2>

    <div class="flex flex-col gap-[80px]">

      <!-- Founder Quote Block -->
      <div class="flex flex-col gap-[80px] overflow-hidden md:flex-row">

        <!-- Image Side -->
        <div class="relative h-[400px] w-full shrink-0 overflow-hidden rounded-[12px] border border-[#232F26] bg-[#162119] p-4 md:h-[490px] md:w-[605px]">
          <img
            src={founderBgImage}
            alt=""
            aria-hidden="true"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover opacity-95 mix-blend-screen"
          />
          <Image
            src={founderImage}
            alt={founderName}
            width={573}
            height={458}
            format="webp"
            quality={85}
            loading="lazy"
            decoding="async"
            class="absolute inset-4 z-10 h-[calc(100%-32px)] w-[calc(100%-32px)] rounded-[8px] object-cover object-bottom"
          />
        </div>

        <!-- Quote Side -->
        <div class="flex flex-1 flex-col justify-center py-8">
          <blockquote class="font-serif text-xl leading-[130%] tracking-[-0.02em] text-[#F9F9F9] md:text-[32px]">
            {founderQuote}
          </blockquote>

          <div class="mt-12">
            <h3 class="font-serif text-[24px] text-[#F9F9F9]">
              {founderName}
            </h3>
            <p class="mt-1 font-sans text-[14px] text-[#A3A3A3]">
              {founderTitle}
            </p>
          </div>
        </div>
      </div>

      <!-- Book Section (Desktop) -->
      <!-- <div class="flex flex-row items-start gap-[48px] rounded-[16px] border border-[#232F26] bg-[#162119] p-10">
        <div class="shrink-0">
          <Image
            src="/images/book.png"
            alt="Money Wise book by Deepak Shenoy"
            width={160}
            height={220}
            format="webp"
            quality={85}
            loading="lazy"
            decoding="async"
            class="rounded-[6px] object-contain"
          />
        </div>
        <div class="flex flex-col gap-4">
          <span class="flex items-center gap-2 font-inter text-[14px] tracking-wide text-[#D4B384]">
            <svg width="4" height="6" viewBox="0 0 4 6" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M4 3L0 0V6L4 3Z" fill="currentColor"/>
            </svg>
            {bookEyebrow}
            <svg width="4" height="6" viewBox="0 0 4 6" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M0 3L4 0V6L0 3Z" fill="currentColor"/>
            </svg>
          </span>
          <h3 class="font-serif text-[24px] leading-[1.2] tracking-[-0.02em] text-[#F9F9F9]">
            {bookHeading}
          </h3>
          <p class="max-w-xl font-inter text-[16px] leading-[1.5] text-[#C0C0C0]">
            {bookDescription}
          </p>
          <a
            href={bookPurchaseHref}
            class="inline-flex items-center self-start border-b border-dashed border-[#EAF5D2] pb-0.5 font-inter text-[16px] font-medium text-[#EAF5D2]"
          >
            {bookPurchaseLabel} <span class="ml-2">↗</span>
          </a>
        </div>
      </div> -->

      <!-- Leadership Grid -->
      <div class="mt-4 flex flex-col">
        <h2 class="mb-8 font-serif text-3xl font-normal tracking-[-0.02em] text-white md:text-[48px]">
          {leadershipHeading}
        </h2>

        <div class="grid grid-cols-1 gap-[16px] md:grid-cols-4">
          {team.map((member) => (
            <div class="relative flex h-[400px] flex-col overflow-hidden rounded-[8px] pt-6">
              <Image
                src={member.image}
                alt={member.name}
                width={300}
                height={400}
                format="webp"
                quality={85}
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover object-top"
              />
              <div class="relative z-10 mb-6 mb-auto px-6">
                <h4 class="font-serif text-[24px] text-[#F9F9F9]">{member.name}</h4>
                <p class="mt-1 font-sans text-[14px] text-[#A3A3A3]">{member.role}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>

  <!-- Mobile version -->
  <div class="block lg:hidden">
    <div class="mx-auto flex w-full lg:max-w-[402px] sm:max-w-[600px] flex-col items-center px-4 text-center">

      <h2 class="mb-6 font-noto font-serif text-[24px] tracking-[-0.02em] text-white">
        Meet Our Founder
      </h2>

      <!-- Founder Image -->
      <div class="relative mb-6 aspect-[5/4] w-full overflow-hidden rounded-b-none rounded-t-[12px] bg-[#0E1511]">
        <img
          src={founderBgImage}
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover opacity-80 mix-blend-screen"
        />
        <Image
          src={founderImage}
          alt={founderName}
          width={402}
          height={322}
          format="webp"
          quality={85}
          loading="lazy"
          decoding="async"
          class="absolute inset-0 z-10 h-full w-full object-cover object-bottom"
        />
      </div>

      <!-- Quote -->
      <blockquote class="mb-6 font-inter text-[16px] font-normal leading-[1.5] text-[#F9F9F9]">
        {founderQuote}
      </blockquote>

      <h3 class="mb-1 font-noto text-[16px] font-medium text-[#F9F9F9] [font-stretch:condensed]">
        {founderName}
      </h3>
      <p class="font-inter text-[16px] font-normal text-[#A3A3A3]">
        {founderTitle}
      </p>

      <!-- Book Section -->
      <div class="mt-16 flex w-full flex-col items-center">
        <div class="mb-4 flex items-center gap-2">
          <span class="flex items-center gap-2 font-inter text-[14px] font-normal tracking-wide text-[#D4B384]">
            <svg width="4" height="6" viewBox="0 0 4 6" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M4 3L0 0V6L4 3Z" fill="currentColor"/>
            </svg>
            {bookEyebrow}
            <svg width="4" height="6" viewBox="0 0 4 6" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M0 3L4 0V6L0 3Z" fill="currentColor"/>
            </svg>
          </span>
        </div>

        <h3
          class="mb-8 font-noto text-[20px] font-medium leading-[1.2] tracking-[-0.02em] text-[#F9F9F9] [font-stretch:condensed]"
        >
          {bookHeading.split(':')[0]}:<br />{bookHeading.split(':').slice(1).join(':').trim()}
        </h3>

        <div class="relative mb-8 flex w-full justify-center">
          <Image
            src="/images/book.png"
            alt="Money Wise book by Deepak Shenoy"
            width={160}
            height={220}
            format="webp"
            quality={85}
            loading="lazy"
            decoding="async"
            class="rounded-[6px] object-contain"
          />
        </div>

        <p class="mb-6 w-full text-left font-inter text-[16px] font-normal leading-[1.5] text-[#C0C0C0]">
          {bookDescription}
        </p>

        <div class="mb-12 flex w-full justify-start">
          <a
            href={bookPurchaseHref}
            class="inline-flex items-center border-b border-dashed border-[#EAF5D2] pb-0.5 font-inter text-[16px] font-medium text-[#EAF5D2]"
          >
            {bookPurchaseLabel} <span class="ml-2 text-[16px]">↗</span>
          </a>
        </div>
      </div>

      <div class="relative -ml-4 -mr-4 w-[calc(100%+32px)]">
        <div
          data-podcast-carousel
          role="region"
          aria-label="Leadership team"
          tabindex="0"
          class="flex w-full snap-x snap-mandatory gap-4 overflow-x-auto pb-4 pl-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-500 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        >
          {team.map((member) => (
            <div class="relative h-[300px] min-w-[250px] shrink-0 snap-center overflow-hidden rounded-[12px]">
              <Image
                src={member.image}
                alt={member.name}
                width={300}
                height={400}
                format="webp"
                quality={85}
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover"
              />
              <div class="relative z-10 mb-6 mb-auto px-6">
                <h4 class="font-serif text-[24px] text-[#F9F9F9]">{member.name}</h4>
                <p class="mt-1 font-sans text-[14px] text-[#A3A3A3]">{member.role}</p>
              </div>
            </div>
          ))}
          <div class="w-1 shrink-0"></div>
        </div>
        <!-- Right gradient fade -->
        <div class="pointer-events-none absolute bottom-4 right-0 top-0 z-10 w-12 bg-gradient-to-l from-[#121B14] to-transparent" aria-hidden="true"></div>
      </div>

      <!-- Pagination Dots -->
      <div class="mt-4 flex justify-center gap-2 pb-0" aria-hidden="true">
        {[0, 1, 2, 3].map((idx) => (
          <div
            data-podcast-dot
            class={`w-2.5 h-2.5 rounded-full transition-colors duration-300 ${idx === 0 ? 'bg-[#455A4B]' : 'bg-[#232F26]'}`}
          ></div>
        ))}
      </div>

    </div>
  </div>

</section>

<script>
  const carousel = document.querySelector('[data-podcast-carousel]') as HTMLElement | null;
  const dots = document.querySelectorAll('[data-podcast-dot]');

  if (carousel && dots.length > 0) {
    carousel.addEventListener('scroll', () => {
      const { scrollLeft, scrollWidth, clientWidth } = carousel;
      if (scrollWidth <= clientWidth) return;

      const scrollPercentage = scrollLeft / (scrollWidth - clientWidth);
      const dotIndex = Math.min(3, Math.max(0, Math.round(scrollPercentage * 3)));

      dots.forEach((dot, i) => {
        dot.classList.toggle('bg-[#455A4B]', i === dotIndex);
        dot.classList.toggle('bg-[#232F26]', i !== dotIndex);
      });
    }, { passive: true });
  }
</script>
