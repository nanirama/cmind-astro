---
interface Props {
  quote: string;
  author: string;
  role?: string;
  variant?: 'default' | 'large' | 'branded';
}

const { quote, author, role, variant = 'default' } = Astro.props;

const isBranded = variant === 'branded';
const isLarge = variant === 'large';

const sectionBgClasses = isBranded
  ? 'bg-[linear-gradient(135deg,var(--color-primary-900)_0%,var(--color-primary-700)_100%)]'
  : 'bg-[var(--color-beige-50)]';

const markColorClass = isBranded
  ? 'text-[color:var(--color-gold-400)]'
  : 'text-[color:var(--color-gold-400)]';

const quoteTextColorClass = isBranded
  ? 'text-[color:var(--color-beige-100)]'
  : 'text-[color:var(--color-text-primary)]';

const quoteTextSizeClass = isLarge
  ? 'text-[clamp(1.5rem,3vw,2.25rem)]'
  : 'text-[clamp(1.25rem,2.5vw,1.875rem)]';

const authorColorClass = isBranded
  ? 'text-[color:var(--color-gold-300)]'
  : 'text-[color:var(--color-text-primary)]';

const roleColorClass = isBranded
  ? 'text-[color:var(--color-beige-400)]'
  : 'text-[color:var(--color-text-tertiary)]';
---

<section
  class:list={['overflow-x-hidden py-[clamp(var(--space-3xl),8vw,var(--space-5xl))] pl-[env(safe-area-inset-left,0px)] pr-[env(safe-area-inset-right,0px)]', sectionBgClasses]}
  aria-label="Featured quote"
>
  <div class="container">
    <figure class="mx-auto flex max-w-[48rem] flex-col items-center gap-[var(--space-lg)] text-center">
      <svg
        class={`shrink-0 ${markColorClass}`}
        width="48"
        height="48"
        viewBox="0 0 48 48"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M14 30A8 8 0 016 22V14a8 8 0 018-8h8v8a8 8 0 01-8 8v8zm20 0a8 8 0 01-8-8V14a8 8 0 018-8h8v8a8 8 0 01-8 8v8z"
          fill="currentColor"
        />
      </svg>
      <blockquote class="m-0 border-none bg-none p-0 not-italic">
        <p
          class={`m-0 font-[family-name:var(--font-serif)] italic leading-[1.5] ${quoteTextSizeClass} ${quoteTextColorClass}`}
        >
          {quote}
        </p>
      </blockquote>
      <figcaption class="flex flex-col items-center gap-[var(--space-3xs)]">
        <span class={`text-[length:var(--fs-body-sm)] font-semibold ${authorColorClass}`}>
          {author}
        </span>
        {role && (
          <span class={`text-[length:var(--fs-body-sm)] ${roleColorClass}`}>
            {role}
          </span>
        )}
      </figcaption>
    </figure>
  </div>
</section>