---
import SectionHeader from '@components/ui/SectionHeader.astro';

interface TimelineEvent {
  year: string;
  heading: string;
  description?: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  events: TimelineEvent[];
}

const { eyebrow, heading, events } = Astro.props;
---

<section class="section py-16 md:py-24 overflow-x-hidden pl-[env(safe-area-inset-left,0px)] pr-[env(safe-area-inset-right,0px)]" aria-label={heading ?? 'Timeline'}>
  <div class="container">
    {(eyebrow || heading) && (
      <SectionHeader eyebrow={eyebrow} heading={heading} align="center" />
    )}
    <ol class="mx-auto mt-[var(--space-2xl)] max-w-[44rem] list-none p-0" aria-label="Company milestones">
      {events.map((event, index) => (
        <li class="relative grid grid-cols-[5rem_1fr] gap-[var(--space-lg)]">
          <div class="flex flex-col items-center pt-[var(--space-3xs)]" aria-hidden="true">
            <div class="z-[1] h-4 w-4 shrink-0 rounded-full border-[3px] border-[var(--color-surface)] bg-[var(--color-gold-500)] shadow-[0_0_0_3px_var(--color-gold-200)]" />
            {index < events.length - 1 && (
              <div class="mt-[var(--space-xs)] min-h-[var(--space-xl)] w-0.5 flex-1 bg-[linear-gradient(to_bottom,var(--color-gold-300),var(--color-border))]" />
            )}
          </div>
          <article class="flex flex-col gap-[var(--space-2xs)] pb-[var(--space-xl)]">
            <time class="font-sans text-[length:var(--fs-body-sm)] font-bold uppercase tracking-wide text-[color:var(--color-gold-600)]">
              {event.year}
            </time>
            <h3 class="m-0 text-[length:var(--fs-body-lg)] font-semibold text-[color:var(--color-text-primary)]">
              {event.heading}
            </h3>
            {event.description && (
              <p class="body-base m-0 max-w-[52ch]">{event.description}</p>
            )}
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>