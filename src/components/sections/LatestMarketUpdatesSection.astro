---
import { Image } from 'astro:assets';

interface Article {
  category: string;
  title: string;
  description: string;
  author: string;
  image: string;
  imageAlt: string;
}

interface Props {
  heading?: string;
  mobileHeading?: string;
  ctaLabel?: string;
  ctaHref?: string;
  newsletterHeading?: string;
  newsletterBody?: string;
  articles: Article[];
}

const {
  heading = 'Keep Up With The Latest Market & Investment Updates',
  mobileHeading = 'Keep up with our Latest offerings & Business updates',
  ctaLabel = 'View More Insights',
  ctaHref = '/insights',
  newsletterHeading = 'Start your wealth journey with Capitalmind today',
  newsletterBody = 'Leading the conversation on wealth with insight, clarity, and conviction. Partnering with experts and investors to create content that informs, challenges, and empowers.',
  articles,
} = Astro.props;

const [left1, left2, featured, right1, right2] = articles;

const mobileHeadingHtml = mobileHeading
  .replace(/&/g, '&amp;')
  .replace('Latest offerings', 'Latest<br/>offerings');

const smallCards = [
  { article: left1,  gridClass: 'lg:col-start-1 lg:row-start-1' },
  { article: left2,  gridClass: 'lg:col-start-1 lg:row-start-2' },
  { article: right1, gridClass: 'lg:col-start-3 lg:row-start-1' },
  { article: right2, gridClass: 'lg:col-start-3 lg:row-start-2' },
];

const avatarImages = [
  '/images/author-pic-1.png',
  '/images/author-pic-2.png',
  '/images/author-pic-1.png',
  '/images/author-pic-2.png',
];
---

<section
  class="w-full overflow-x-hidden bg-primary-900 py-[48px] pl-[env(safe-area-inset-left,0px)] pr-[env(safe-area-inset-right,0px)] lg:py-24"
  aria-labelledby="market-updates-heading"
>
  <div class="mx-auto max-w-7xl px-4">

    <!-- Desktop heading -->
    <div class="mb-10 hidden text-center lg:mb-14 lg:block">
      <h2
        id="market-updates-heading"
        class="mx-auto max-w-2xl font-serif text-[48px] font-normal leading-[120%] tracking-[-0.05em] text-white [font-stretch:condensed]"
      >
        {heading}
      </h2>
    </div>

    <!-- Mobile version -->
    <div class="mx-auto flex w-full max-w-[402px] flex-col items-center lg:hidden">
      <h2
        class="mb-8 px-2 text-center font-noto text-[24px] font-medium leading-[1.2] tracking-[-0.02em] text-[#F4F2EA]"
        set:html={mobileHeadingHtml}
      />

      <div class="flex w-full flex-col gap-3 px-4">
        <!-- Featured image -->
        <div class="relative w-full aspect-[370/481] overflow-hidden rounded-[16px]">
          <Image
            src={featured.image}
            alt={featured.imageAlt}
            width={370}
            height={481}
            format="webp"
            quality={85}
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover"
          />
        </div>

        <!-- Tag -->
        <div class="w-fit rounded-lg bg-[#051501] px-3 py-1.5">
          <span class="font-inter text-[14px] font-normal text-[#AEDD84]">
            {featured.category}
          </span>
        </div>

        <!-- Title -->
        <h3 class="font-noto text-[24px] font-medium leading-[1.2] tracking-tight text-[#F4F2EA]">
          {featured.title}
        </h3>

        <!-- Description -->
        <p class="font-inter text-[16px] font-normal leading-[1.5] text-[#989898]">
          {featured.description}
        </p>

        <!-- Author -->
        <span class="font-inter text-[16px] font-medium text-[#F4F2EA]">
          {featured.author}
        </span>
      </div>

      <!-- CTA button -->
      <div class="mt-8 flex w-full justify-center pb-0">
        <a
          href={ctaHref}
          class="flex w-[200px] items-center justify-center rounded-[8px] border border-[rgba(244,242,234,0.3)] py-2.5 font-inter text-[16px] font-medium text-[#F4F2EA] transition-colors hover:border-[#F4F2EA] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-500"
        >
          {ctaLabel}
        </a>
      </div>
    </div>

    <!-- Desktop grid: 3-col, featured center card spans 2 rows -->
    <div class="hidden lg:grid lg:h-[860px] lg:grid-cols-[1fr_1.3fr_1fr] lg:grid-rows-2 lg:gap-4">
      <!-- 4 small cards -->
      {smallCards.map(({ article, gridClass }) => (
        <div class:list={['h-full', gridClass]}>
          <article class="group flex h-full flex-col overflow-hidden rounded-2xl border border-[rgba(174,221,132,0.08)] bg-[#121b14] transition-colors duration-300">
            <div class="relative h-[185px] w-full shrink-0 overflow-hidden">
              <Image
                src={article.image}
                alt={article.imageAlt}
                width={390}
                height={185}
                format="webp"
                quality={85}
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>
            <div class="flex flex-1 flex-col gap-3 p-4">
              <span class="inline-flex w-fit items-center rounded-lg bg-[#051501] px-3 py-1.5 font-inter text-[14px] font-normal leading-[1.4] text-primary-100">
                {article.category}
              </span>
              <h3 class="line-clamp-2 font-serif text-[24px] font-medium leading-snug tracking-[-0.02em] text-text-inverse">
                {article.title}
              </h3>
              <p class="line-clamp-2 flex-1 font-inter text-[16px] font-normal leading-relaxed text-beige-600">
                {article.description}
              </p>
              <p class="font-inter text-[16px] font-medium text-beige-700">
                {article.author}
              </p>
            </div>
          </article>
        </div>
      ))}

      <!-- Featured card: center column, spans both rows -->
      <div class="h-full lg:col-start-2 lg:row-start-1 lg:row-span-2">
        <article class="group flex h-full flex-col overflow-hidden rounded-2xl border border-[rgba(174,221,132,0.08)] bg-[#121b14] transition-colors duration-300">
          <div class="relative min-h-52 flex-1 overflow-hidden sm:min-h-64">
            <Image
              src={featured.image}
              alt={featured.imageAlt}
              width={504}
              height={640}
              format="webp"
              quality={85}
              loading="lazy"
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </div>
          <div class="flex shrink-0 flex-col gap-3 p-5">
            <span class="inline-flex w-fit items-center rounded-lg bg-[#051501] px-3 py-1.5 font-inter text-[14px] font-normal leading-[1.4] text-primary-100">
              {featured.category}
            </span>
            <h3 class="font-serif text-[24px] font-medium leading-snug tracking-[-0.02em] text-text-inverse">
              {featured.title}
            </h3>
            <p class="line-clamp-3 font-inter text-[16px] font-normal leading-relaxed text-beige-600">
              {featured.description}
            </p>
            <p class="font-inter text-[16px] font-medium text-beige-700">
              {featured.author}
            </p>
          </div>
        </article>
      </div>
    </div>

    <!-- Newsletter CTA (desktop only) -->
    <div class="relative mt-20 hidden items-start gap-12 border-t border-[rgba(255,255,255,0.1)] pt-20 lg:flex lg:flex-row">
      <!-- Radial glow -->
      <div
        aria-hidden="true"
        class="pointer-events-none absolute right-[-80px] top-1/2 h-[600px] w-[600px] -translate-y-1/2 rounded-full bg-[radial-gradient(circle,rgba(30,80,35,0.25)_0%,rgba(18,27,20,0)_70%)]"
      ></div>

      <!-- Left: copy -->
      <div class="flex flex-1 flex-col gap-6">
        <h2 class="font-serif text-[clamp(2rem,4vw,48px)] font-medium leading-[110%] tracking-[-0.04em] text-white [font-stretch:condensed]">
          {newsletterHeading}
        </h2>
        <p class="max-w-[420px] font-inter text-[16px] font-normal leading-[160%] text-white/60">
          {newsletterBody}
        </p>

        <!-- Social proof -->
        <div class="mt-2 flex items-center gap-3">
          <div class="flex -space-x-3">
            {avatarImages.map((src) => (
              <div class="relative h-10 w-10 overflow-hidden rounded-full border-2 border-primary-900">
                <img src={src} alt="" aria-hidden="true" width={40} height={40} loading="lazy" decoding="async" class="h-full w-full object-cover" />
              </div>
            ))}
          </div>
          <p class="font-inter text-[14px] font-medium text-white/75">
            30K+ Daily Readers Subscribed
          </p>
        </div>
      </div>

      <!-- Right: newsletter form -->
      <div class="flex w-full shrink-0 flex-col gap-4 lg:w-[480px]">
        <!-- Full Name -->
        <div class="flex flex-col gap-1.5">
          <label for="newsletter-name" class="font-inter text-[14px] font-normal text-white/80">
            Full Name
          </label>
          <input
            id="newsletter-name"
            type="text"
            placeholder="Enter your full name"
            class="w-full rounded-xl border border-[rgba(100,180,100,0.2)] bg-[#0C1E10] px-4 py-4 font-inter text-[15px] text-[#E8F5E9] transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-500"
          />
        </div>

        <!-- Email -->
        <div class="flex flex-col gap-1.5">
          <label for="newsletter-email" class="font-inter text-[14px] font-normal text-white/80">
            Email Address
          </label>
          <input
            id="newsletter-email"
            type="email"
            placeholder="Enter your email address"
            class="w-full rounded-xl border border-[rgba(100,180,100,0.2)] bg-[#0C1E10] px-4 py-4 font-inter text-[15px] text-[#E8F5E9] transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-500"
          />
        </div>

        <!-- Subscribe button -->
        <button
          type="button"
          class="mt-1 w-full rounded-lg bg-[#FEF9E7] py-3.5 font-inter text-[15px] font-medium text-[#121B14] transition-opacity hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-500"
        >
          Subscribe to Newsletter
        </button>

        <!-- OR divider -->
        <div class="flex items-center gap-3">
          <div class="h-px flex-1 bg-[rgba(100,180,100,0.2)]"></div>
          <span class="font-inter text-[13px] text-[rgba(100,180,100,0.5)]">OR</span>
          <div class="h-px flex-1 bg-[rgba(100,180,100,0.2)]"></div>
        </div>

        <!-- Google sign-up button -->
        <button
          type="button"
          class="flex w-full items-center justify-center gap-3 rounded-xl border border-[rgba(201,169,110,0.4)] py-4 font-inter text-[15px] font-medium text-white transition-opacity hover:opacity-80 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-500"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M21.805 10.023H12v3.977h5.617c-.242 1.242-.976 2.296-2.078 3l3.164 2.461C20.34 17.773 22 15.114 22 12c0-.68-.067-1.34-.195-1.977z" fill="#FFFFFF"/>
            <path d="M5.418 14.283A6.545 6.545 0 015 12c0-.801.144-1.574.406-2.293L2.18 7.219A10.963 10.963 0 001 12c0 1.742.418 3.387 1.156 4.844l3.262-2.561z" fill="#FFFFFF"/>
            <path d="M12 23c2.766 0 5.086-.918 6.781-2.484l-3.164-2.461C14.68 18.738 13.406 19 12 19c-2.742 0-5.063-1.852-5.895-4.344l-3.262 2.561C4.57 20.453 8.035 23 12 23z" fill="#FFFFFF"/>
            <path d="M12 5c1.563 0 2.965.538 4.068 1.418l3.047-3.047C17.086 1.523 14.695.5 12 .5 8.035.5 4.57 3.047 2.843 6.656l3.262 2.561C6.937 6.852 9.258 5 12 5z" fill="#FFFFFF"/>
          </svg>
          Sign up using google
        </button>
      </div>
    </div>

  </div>
</section>
