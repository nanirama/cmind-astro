---
import { Image } from 'astro:assets';

interface Article {
  category: string;
  title: string;
  description: string;
  author: string;
  image: string;
  imageAlt: string;
}

interface Props {
  heading?: string;
  mobileHeading?: string;
  ctaLabel?: string;
  ctaHref?: string;
  newsletterHeading?: string;
  newsletterBody?: string;
  articles: Article[];
}

const {
  heading = 'Keep Up With The Latest Market & Investment Updates',
  mobileHeading = 'Keep up with our Latest offerings & Business updates',
  ctaLabel = 'View More Insights',
  ctaHref = '/insights',
  newsletterHeading = 'Start your wealth journey with Capitalmind today',
  newsletterBody = 'Leading the conversation on wealth with insight, clarity, and conviction. Partnering with experts and investors to create content that informs, challenges, and empowers.',
  articles,
} = Astro.props;

const [left1, left2, featured, right1, right2] = articles;

const mobileHeadingHtml = mobileHeading
  .replace(/&/g, '&amp;')
  .replace('Latest offerings', 'Latest<br/>offerings');

const smallCards = [
  { article: left1,  col: 1, row: 1 },
  { article: left2,  col: 1, row: 2 },
  { article: right1, col: 3, row: 1 },
  { article: right2, col: 3, row: 2 },
];

const avatarImages = [
  '/images/author-pic-1.png',
  '/images/author-pic-2.png',
  '/images/author-pic-1.png',
  '/images/author-pic-2.png',
];
---

<section
  class="w-full py-[48px] lg:py-24 overflow-hidden"
  style="background: var(--color-primary-900);"
  aria-labelledby="market-updates-heading"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    <!-- Desktop heading -->
    <div class="hidden lg:block mb-10 text-center lg:mb-14">
      <h2
        id="market-updates-heading"
        class="mx-auto max-w-2xl text-white"
        style="font-family: 'Noto Serif', serif; font-stretch: condensed; font-size: 48px; font-weight: 400; line-height: 120%; letter-spacing: -0.05em;"
      >
        {heading}
      </h2>
    </div>

    <!-- Mobile version -->
    <div class="block lg:hidden w-full max-w-[402px] mx-auto flex flex-col items-center">
      <h2
        class="text-[24px] font-medium font-noto tracking-[-0.02em] text-[#F4F2EA] text-center mb-8 px-2 leading-[1.2]"
        set:html={mobileHeadingHtml}
      />

      <div class="w-full px-4 flex flex-col gap-3">
        <!-- Featured image -->
        <div class="relative w-full aspect-[370/481] rounded-[16px] overflow-hidden">
          <Image
            src={featured.image}
            alt={featured.imageAlt}
            width={370}
            height={481}
            format="webp"
            quality={85}
            loading="lazy"
            decoding="async"
            class="absolute inset-0 w-full h-full object-cover"
          />
        </div>

        <!-- Tag -->
        <div class="bg-[#051501] rounded-lg px-3 py-1.5 w-fit">
          <span class="text-[#AEDD84] text-[14px] font-normal font-inter">
            {featured.category}
          </span>
        </div>

        <!-- Title -->
        <h3 class="text-[#F4F2EA] text-[24px] font-medium font-noto tracking-tight leading-[1.2]">
          {featured.title}
        </h3>

        <!-- Description -->
        <p class="text-[#989898] text-[16px] font-normal font-inter leading-[1.5]">
          {featured.description}
        </p>

        <!-- Author -->
        <span class="text-[#F4F2EA] text-[16px] font-medium font-inter">
          {featured.author}
        </span>
      </div>

      <!-- CTA button -->
      <div class="w-full flex justify-center mt-8 pb-0">
        <a
          href={ctaHref}
          class="w-[200px] border border-[rgba(244,242,234,0.3)] hover:border-[#F4F2EA] transition-colors rounded-[8px] py-2.5 flex items-center justify-center text-[#F4F2EA] text-[16px] font-medium font-inter"
        >
          {ctaLabel}
        </a>
      </div>
    </div>

    <!-- Desktop grid: 3-col, featured center card spans 2 rows -->
    <div
      class="hidden lg:grid lg:h-[860px] lg:gap-4"
      style="grid-template-columns: 1fr 1.3fr 1fr; grid-template-rows: 1fr 1fr;"
    >
      <!-- 4 small cards -->
      {smallCards.map(({ article, col, row }) => (
        <div class="h-full" style={`grid-column: ${col}; grid-row: ${row};`}>
          <article
            class="bg-[#121b14] group flex h-full flex-col overflow-hidden rounded-2xl transition-colors duration-300"
            style="border: 1px solid rgba(174, 221, 132, 0.08);"
          >
            <div class="relative h-[185px] w-full shrink-0 overflow-hidden">
              <Image
                src={article.image}
                alt={article.imageAlt}
                width={390}
                height={185}
                format="webp"
                quality={85}
                loading="lazy"
                decoding="async"
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>
            <div class="flex flex-1 flex-col gap-3 p-4">
              <span
                class="inline-flex items-center rounded-lg px-3 py-1.5"
                style="background: #051501; color: var(--color-primary-100); font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 400; line-height: 1.4; letter-spacing: 0;"
              >
                {article.category}
              </span>
              <h3
                class="line-clamp-2 leading-snug"
                style="color: var(--color-text-inverse); font-family: 'Noto Serif', serif; font-size: 24px; font-weight: 500; letter-spacing: -0.02em;"
              >
                {article.title}
              </h3>
              <p
                class="line-clamp-2 flex-1 leading-relaxed"
                style="color: var(--color-beige-600); font-family: 'Inter', sans-serif; font-size: 16px; font-weight: 400;"
              >
                {article.description}
              </p>
              <p style="color: var(--color-beige-700); font-family: 'Inter', sans-serif; font-size: 16px; font-weight: 500;">
                {article.author}
              </p>
            </div>
          </article>
        </div>
      ))}

      <!-- Featured card: center column, spans both rows -->
      <div class="h-full" style="grid-column: 2; grid-row: 1 / 3;">
        <article
          class="bg-[#121b14] group flex h-full flex-col overflow-hidden rounded-2xl transition-colors duration-300"
          style="border: 1px solid rgba(174, 221, 132, 0.08);"
        >
          <div class="relative min-h-52 flex-1 overflow-hidden sm:min-h-64">
            <Image
              src={featured.image}
              alt={featured.imageAlt}
              width={504}
              height={640}
              format="webp"
              quality={85}
              loading="lazy"
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </div>
          <div class="flex shrink-0 flex-col gap-3 p-5">
            <span
              class="inline-flex items-center rounded-lg px-3 py-1.5"
              style="background: #051501; color: var(--color-primary-100); font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 400; line-height: 1.4; letter-spacing: 0;"
            >
              {featured.category}
            </span>
            <h3
              class="leading-snug"
              style="color: var(--color-text-inverse); font-family: 'Noto Serif', serif; font-size: 24px; font-weight: 500; letter-spacing: -0.02em;"
            >
              {featured.title}
            </h3>
            <p
              class="line-clamp-3 leading-relaxed"
              style="color: var(--color-beige-600); font-family: 'Inter', sans-serif; font-size: 16px; font-weight: 400;"
            >
              {featured.description}
            </p>
            <p style="color: var(--color-beige-700); font-family: 'Inter', sans-serif; font-size: 16px; font-weight: 500;">
              {featured.author}
            </p>
          </div>
        </article>
      </div>
    </div>

    <!-- Newsletter CTA (desktop only) -->
    <div
      class="hidden lg:flex flex-col lg:flex-row items-start relative"
      style="margin-top: 80px; padding-top: 80px; border-top: 1px solid rgba(255,255,255,0.1); gap: 48px;"
    >
      <!-- Radial glow -->
      <div
        aria-hidden="true"
        style="position: absolute; right: -80px; top: 50%; transform: translateY(-50%); width: 600px; height: 600px; border-radius: 50%; background: radial-gradient(circle, rgba(30,80,35,0.25) 0%, rgba(18,27,20,0) 70%); pointer-events: none;"
      ></div>

      <!-- Left: copy -->
      <div class="flex-1 flex flex-col gap-6">
        <h2 style="font-family: 'Noto Serif', serif; font-stretch: condensed; font-size: clamp(2rem, 4vw, 48px); font-weight: 500; line-height: 110%; letter-spacing: -0.04em; color: #FFFFFF;">
          {newsletterHeading}
        </h2>
        <p style="font-family: 'Inter', sans-serif; font-size: 16px; font-weight: 400; line-height: 160%; color: rgba(255,255,255,0.6); max-width: 420px;">
          {newsletterBody}
        </p>

        <!-- Social proof -->
        <div class="flex items-center gap-3 mt-2">
          <div class="flex -space-x-3">
            {avatarImages.map((src) => (
              <div
                class="relative w-10 h-10 rounded-full overflow-hidden border-2"
                style="border-color: var(--color-primary-900);"
              >
                <img src={src} alt="" aria-hidden="true" class="w-full h-full object-cover" />
              </div>
            ))}
          </div>
          <p style="font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 500; color: rgba(255,255,255,0.75);">
            30K+ Daily Readers Subscribed
          </p>
        </div>
      </div>

      <!-- Right: newsletter form -->
      <div class="w-full lg:w-[480px] flex flex-col gap-4 shrink-0">
        <!-- Full Name -->
        <div class="flex flex-col gap-1.5">
          <label
            for="newsletter-name"
            style="font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 400; color: rgba(255,255,255,0.8);"
          >
            Full Name
          </label>
          <input
            id="newsletter-name"
            type="text"
            placeholder="Enter your full name"
            class="w-full rounded-xl px-4 py-4 outline-none transition-colors"
            style="background: #0C1E10; border: 1px solid rgba(100, 180, 100, 0.2); color: #E8F5E9; font-family: 'Inter', sans-serif; font-size: 15px;"
          />
        </div>

        <!-- Email -->
        <div class="flex flex-col gap-1.5">
          <label
            for="newsletter-email"
            style="font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 400; color: rgba(255,255,255,0.8);"
          >
            Email Address
          </label>
          <input
            id="newsletter-email"
            type="email"
            placeholder="Enter your email address"
            class="w-full rounded-xl px-4 py-4 outline-none transition-colors"
            style="background: #0C1E10; border: 1px solid rgba(100, 180, 100, 0.2); color: #E8F5E9; font-family: 'Inter', sans-serif; font-size: 15px;"
          />
        </div>

        <!-- Subscribe button -->
        <button
          type="button"
          class="w-full rounded-lg py-3.5 font-medium transition-opacity hover:opacity-90"
          style="background: #FEF9E7; color: #121B14; font-family: 'Inter', sans-serif; font-size: 15px; font-weight: 500; margin-top: 4px;"
        >
          Subscribe to Newsletter
        </button>

        <!-- OR divider -->
        <div class="flex items-center gap-3">
          <div class="flex-1 h-px" style="background: rgba(100,180,100,0.2);"></div>
          <span style="font-family: 'Inter', sans-serif; font-size: 13px; color: rgba(100,180,100,0.5);">OR</span>
          <div class="flex-1 h-px" style="background: rgba(100,180,100,0.2);"></div>
        </div>

        <!-- Google sign-up button -->
        <button
          type="button"
          class="w-full rounded-xl py-4 flex items-center justify-center gap-3 transition-opacity hover:opacity-80"
          style="background: transparent; border: 1px solid rgba(201, 169, 110, 0.4); color: #FFFFFF; font-family: 'Inter', sans-serif; font-size: 15px; font-weight: 500;"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M21.805 10.023H12v3.977h5.617c-.242 1.242-.976 2.296-2.078 3l3.164 2.461C20.34 17.773 22 15.114 22 12c0-.68-.067-1.34-.195-1.977z" fill="#FFFFFF"/>
            <path d="M5.418 14.283A6.545 6.545 0 015 12c0-.801.144-1.574.406-2.293L2.18 7.219A10.963 10.963 0 001 12c0 1.742.418 3.387 1.156 4.844l3.262-2.561z" fill="#FFFFFF"/>
            <path d="M12 23c2.766 0 5.086-.918 6.781-2.484l-3.164-2.461C14.68 18.738 13.406 19 12 19c-2.742 0-5.063-1.852-5.895-4.344l-3.262 2.561C4.57 20.453 8.035 23 12 23z" fill="#FFFFFF"/>
            <path d="M12 5c1.563 0 2.965.538 4.068 1.418l3.047-3.047C17.086 1.523 14.695.5 12 .5 8.035.5 4.57 3.047 2.843 6.656l3.262 2.561C6.937 6.852 9.258 5 12 5z" fill="#FFFFFF"/>
          </svg>
          Sign up using google
        </button>
      </div>
    </div>

  </div>
</section>
