---
import { Image } from 'astro:assets';

interface Testimonial {
  quote: string;
  mobileQuote?: string;
  name: string;
  role: string;
  image: string;
  wide?: boolean;
  showOnMobile?: boolean;
}

interface Props {
  heading?: string;
  testimonials: Testimonial[];
}

const {
  heading = "Don't listen to us, look at what our Clients have to say about us",
  testimonials,
} = Astro.props;

const mobileTestimonials = testimonials.filter(t => t.showOnMobile !== false);
const mobileHeading = heading.replace('look at what our', 'look at what<br />our');
---

<section class="relative w-full overflow-hidden py-[48px] pl-[env(safe-area-inset-left,0px)] pr-[env(safe-area-inset-right,0px)] lg:py-28">

  <!-- Desktop version -->
  <div class="hidden lg:block">

    <!-- Decorative SVG top-right -->
    <div
      class="pointer-events-none absolute right-0 top-0 h-[200px] w-[38%] select-none overflow-hidden opacity-25"
      aria-hidden="true"
    >
      <img
        src="/images/Clip path group.svg"
        alt=""
        aria-hidden="true"
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover object-left-top"
      />
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2
        class="relative z-10 mb-10 max-w-[720px] font-serif text-[48px] font-normal leading-[120%] tracking-[-0.05em] text-[#121B14] [font-stretch:condensed] lg:mb-14"
      >
        {heading}
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-5">
        {testimonials.map((testimonial) => (
          <div
            class={`flex flex-col rounded-xl bg-white p-6 shadow-[0_0_24px_0_rgba(0,0,0,0.05)] lg:p-8 ${testimonial.wide ? 'lg:col-span-2' : 'lg:col-span-1'}`}
          >
            <p class="text-body-base leading-[1.6] text-[#121B14]">
              &ldquo;{testimonial.quote}&rdquo;
            </p>

            <div class="flex items-center gap-3 mt-auto pt-6">
              <div class="relative w-12 h-12 shrink-0 rounded-full overflow-hidden">
                <Image
                  src={testimonial.image}
                  alt={testimonial.name}
                  width={48}
                  height={48}
                  format="webp"
                  quality={85}
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 w-full h-full object-cover"
                />
              </div>
              <div class="flex flex-col gap-0.5">
                <span class="text-body-sm font-medium leading-tight text-[#121B14]">
                  {testimonial.name}
                </span>
                <span class="text-body-sm leading-tight text-beige-700">
                  {testimonial.role}
                </span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Mobile version -->
  <div class="block lg:hidden w-full max-w-[402px] mx-auto px-4 flex flex-col items-center">
    <h2
      class="text-[24px] font-medium font-noto tracking-[-0.02em] text-[#121B14] text-center mb-8 px-2 leading-[1.2]"
      set:html={mobileHeading}
    />

    <div class="relative w-[calc(100%+32px)] -ml-4 -mr-4">
      <div
        data-testimonials-carousel
        role="region"
        aria-label="Client testimonials"
        tabindex="0"
        class="flex w-full snap-x snap-mandatory items-stretch gap-4 overflow-x-auto pb-4 pl-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-500 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        {mobileTestimonials.map((testimonial) => (
          <div class="w-[270px] shrink-0 bg-white rounded-[16px] p-6 flex flex-col snap-center shadow-sm">
            <p class="text-[#4A4A4A] text-[16px] font-normal font-inter leading-[1.5] mb-8">
              "{testimonial.mobileQuote ?? testimonial.quote}"
            </p>
            <div class="flex items-center gap-4 mt-auto">
              <Image
                src={testimonial.image}
                alt={testimonial.name}
                width={48}
                height={48}
                format="webp"
                quality={85}
                loading="lazy"
                decoding="async"
                class="rounded-full object-cover w-12 h-12 shrink-0"
              />
              <div class="flex flex-col">
                <span class="text-[#121B14] text-[18px] font-medium font-noto tracking-tight">{testimonial.name}</span>
                <span class="text-[14px] font-normal font-inter text-text-secondary">{testimonial.role}</span>
              </div>
            </div>
          </div>
        ))}
        <div class="w-1 shrink-0"></div>
      </div>

      <!-- Right gradient fade -->
      <div
        class="absolute top-0 right-0 bottom-4 w-12 bg-gradient-to-l from-[#EDEADE] to-transparent pointer-events-none z-10"
        aria-hidden="true"
      ></div>
    </div>

    <!-- Pagination dots -->
    <div class="flex gap-2 justify-center pb-0 mt-4" aria-hidden="true">
      {mobileTestimonials.map((_, idx) => (
        <div
          data-testimonials-dot
          class={`w-2.5 h-2.5 rounded-full transition-colors duration-300 ${idx === 0 ? 'bg-[#A39987]' : 'bg-[#DCD4C1]'}`}
        ></div>
      ))}
    </div>
  </div>

</section>

<script>
  const carousel = document.querySelector('[data-testimonials-carousel]') as HTMLElement | null;
  const dots = document.querySelectorAll('[data-testimonials-dot]');

  if (carousel && dots.length > 0) {
    carousel.addEventListener('scroll', () => {
      const { scrollLeft, scrollWidth, clientWidth } = carousel;
      if (scrollWidth <= clientWidth) return;

      const scrollPercentage = scrollLeft / (scrollWidth - clientWidth);
      const count = dots.length;
      const dotIndex = Math.min(count - 1, Math.max(0, Math.round(scrollPercentage * (count - 1))));

      dots.forEach((dot, i) => {
        dot.classList.toggle('bg-[#A39987]', i === dotIndex);
        dot.classList.toggle('bg-[#DCD4C1]', i !== dotIndex);
      });
    }, { passive: true });
  }
</script>
