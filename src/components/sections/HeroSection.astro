---
import Button from '@components/ui/Button.astro';
import { HERO_SIZES } from '@utils/image';

interface Cta {
  label: string;
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'gold';
  external?: boolean;
}

interface HeroImage {
  src: string;
  alt: string;
  width?: number;
  height?: number;
}

interface Props {
  eyebrow?: string;
  heading: string;
  subheading?: string;
  body?: string;
  ctas?: Cta[];
  image?: HeroImage;
  backgroundVariant?: 'default' | 'gradient' | 'dark' | 'image';
  fullHeight?: boolean;
}

const {
  eyebrow,
  heading,
  subheading,
  body,
  ctas = [],
  image,
  backgroundVariant = 'default',
  fullHeight = false,
} = Astro.props;

const isDark = backgroundVariant === 'dark';

const sectionBgClasses = {
  default: 'bg-[var(--color-surface)]',
  gradient:
    'bg-[linear-gradient(135deg,var(--color-beige-50)_0%,var(--color-primary-50)_50%,var(--color-beige-100)_100%)]',
  dark: 'bg-[var(--color-primary-900)] text-[color:var(--color-text-inverse)]',
  image: '',
}[backgroundVariant];

const eyebrowColorClass = isDark ? 'text-[color:var(--color-gold-400)]' : '';
const headingColorClass = isDark ? 'text-[color:var(--color-beige-100)]' : '';
const subheadingColorClass = isDark
  ? 'text-[color:var(--color-beige-100)]'
  : 'text-[color:var(--color-text-secondary)]';
const bodyColorClass = isDark ? 'text-[color:var(--color-beige-300)]' : '';
---

<section
  class:list={[
    'relative overflow-hidden py-16 md:py-24 pl-[env(safe-area-inset-left,0px)] pr-[env(safe-area-inset-right,0px)]',
    sectionBgClasses,
    fullHeight && 'flex min-h-[100dvh] items-center',
  ]}
  aria-label={`${heading} hero`}
>
  <div class:list={['container', fullHeight && 'w-full']}>
    <div
      class:list={[
        'relative z-[1]',
        image
          ? 'grid grid-cols-1 items-center gap-[var(--space-2xl)] md:grid-cols-2'
          : 'mx-auto flex max-w-[56rem] flex-col items-center text-center',
      ]}
    >
      <!-- Text content -->
      <div>
        {eyebrow && (
          <p class:list={['eyebrow mb-[var(--space-sm)]', eyebrowColorClass]}>
            {eyebrow}
          </p>
        )}

        <h1
          class:list={[
            'mb-[var(--space-md)] text-balance text-[length:var(--fs-h1)] leading-[var(--lh-h1)] tracking-[var(--ls-h1)]',
            headingColorClass,
          ]}
        >
          {heading}
        </h1>

        {subheading && (
          <p
            class:list={[
              'mb-[var(--space-md)] text-pretty font-[family-name:var(--font-serif)] text-[length:var(--fs-h3)] font-normal leading-[var(--lh-h3)]',
              subheadingColorClass,
            ]}
          >
            {subheading}
          </p>
        )}

        {body && (
          <p class:list={['body-lg mb-[var(--space-xl)] text-pretty', bodyColorClass]}>
            {body}
          </p>
        )}

        {ctas.length > 0 && (
          <div
            class:list={[
              'flex flex-wrap gap-[var(--space-sm)]',
              !image && 'justify-center',
            ]}
            role="group"
            aria-label="Call to action"
          >
            {ctas.map((cta) => (
              <Button
                href={cta.href}
                variant={cta.variant ?? 'primary'}
                size="lg"
                external={cta.external}
              >
                {cta.label}
              </Button>
            ))}
          </div>
        )}

        <slot name="content-extra" />
      </div>

      <!-- Hero image -->
      {image && (
        <div
          class="relative aspect-[4/3] overflow-hidden rounded-[var(--radius-xl)]"
          aria-hidden={!image.alt ? 'true' : undefined}
        >
          <img
            src={image.src}
            alt={image.alt}
            width={image.width ?? 800}
            height={image.height ?? 600}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            sizes={HERO_SIZES}
            class="h-full w-full object-cover"
          />
        </div>
      )}
    </div>
  </div>

  <!-- Background decoration -->
  <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
    <slot name="bg-decoration" />
  </div>
</section>