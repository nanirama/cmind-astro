---
import BaseLayout from './BaseLayout.astro';
import type { SeoProps } from '@lib/seo';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import { formatDate } from '@utils/date';

interface BreadcrumbItem {
  label: string;
  href: string;
}

interface Props extends SeoProps {
  publishDate?: Date;
  updatedDate?: Date;
  author?: string;
  readingTime?: string;
  category?: string;
  showBreadcrumb?: boolean;
  breadcrumb?: BreadcrumbItem[];
  maxWidth?: 'narrow' | 'default' | 'wide';
}

const {
  publishDate,
  updatedDate,
  author,
  readingTime,
  category,
  showBreadcrumb = true,
  breadcrumb = [],
  maxWidth = 'default',
  ...seoProps
} = Astro.props;

const maxWidthClass = {
  narrow:  'container-narrow',
  default: 'container',
  wide:    'container-wide',
}[maxWidth];
---

<BaseLayout {...seoProps} ogType="article">
  <slot name="head" slot="head" />

  {showBreadcrumb && breadcrumb.length > 0 && (
    <div class="content-layout__breadcrumb">
      <div class={maxWidthClass}>
        <Breadcrumb items={breadcrumb} />
      </div>
    </div>
  )}

  <article class="content-layout">
    <div class={maxWidthClass}>
      <!-- Article header -->
      <header class="content-layout__header">
        {category && <span class="eyebrow">{category}</span>}
        <slot name="title" />
        <div class="content-layout__meta">
          {publishDate && (
            <time datetime={publishDate.toISOString()} class="content-layout__date">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              {formatDate(publishDate)}
            </time>
          )}
          {updatedDate && (
            <span class="content-layout__updated">
              Updated {formatDate(updatedDate)}
            </span>
          )}
          {author && (
            <span class="content-layout__author">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
              {author}
            </span>
          )}
          {readingTime && (
            <span class="content-layout__reading-time">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              {readingTime}
            </span>
          )}
        </div>
      </header>

      <!-- Featured image slot -->
      <slot name="featured-image" />

      <!-- Body content -->
      <div class="content-layout__body prose prose-cm">
        <slot />
      </div>

      <!-- Footer slot -->
      <slot name="footer" />
    </div>
  </article>
</BaseLayout>

<style>
  .content-layout__breadcrumb {
    padding-block: var(--space-sm);
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-surface-raised);
  }

  .content-layout {
    padding-block: var(--space-3xl);
  }

  .content-layout__header {
    margin-bottom: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .content-layout__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
    font-size: var(--fs-text-sm);
    color: var(--color-text-tertiary);
    padding-top: var(--space-xs);
    border-top: 1px solid var(--color-border);
  }

  .content-layout__date,
  .content-layout__updated,
  .content-layout__author,
  .content-layout__reading-time {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
  }

  .content-layout__body {
    max-width: 72ch;
  }
</style>
